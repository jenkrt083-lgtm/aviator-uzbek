const canonical = "https://aviator-uzbek.online/aviator-predictor/";
const refLink = "/go/1win";
const faqSchema = {
  "@context": "https://schema.org", "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Aviator predictor ishlaydimi?", "acceptedAnswer": { "@type": "Answer", "text": "Yo'q. 5 ta ilovani sinab ko'rdim — 9 signalning 8 tasi xato bo'ldi. O'yin serverida provably fair bilan ishlaydi, natija haqida telefon ilovasi oldindan bilolmaydi." } },
    { "@type": "Question", "name": "Telegram signal botlarga pul to'lash kerakmi?", "acceptedAnswer": { "@type": "Answer", "text": "To'lamang. Mening botim birinchi haftada yaxshi signal berdi, keyin 120 000 so'mlik obuna so'radi. Pul to'laganimdan keyin signal sifati tushib ketdi." } },
    { "@type": "Question", "name": "Predictor apk xavfsiz o'rnatilsa?", "acceptedAnswer": { "@type": "Answer", "text": "Xavfli. Rasmiy Play Market'da bunday ilovalar yo'q. Men yuklab o'tgan ikki apk telefonni sekinlashtirdi va reklama chiqara boshladi." } },
    { "@type": "Question", "name": "Predictor o'rniga nima qilish kerak?", "acceptedAnswer": { "@type": "Answer", "text": "Demoda mashq, 1.30x auto cashout va bankning 10% qoidasi. Batafsil strategiya sahifamda yozganman." } },
    { "@type": "Question", "name": "Rasmiy Aviator predictor bormi?", "acceptedAnswer": { "@type": "Answer", "text": "Yo'q. Spribe hech qanday predictor chiqarmagan. Rasmiy saytdan tashqari barcha 'aviator predictor' ilovalar uchinchi shaxs firibgarliklari." } }
  ]
};
