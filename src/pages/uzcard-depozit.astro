      font-weight: 700;
      color: #f1f5f9;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      list-style: none;
    }
    .faq-q::-webkit-details-marker { display: none; }
    .faq-q::after {
      content: '+';
      font-size: 16px;
      color: #007aff;
      font-weight: 700;
    }
    details[open] .faq-q::after { content: '−'; }
    .faq-a {
      padding: 0 15px 13px;
      font-size: 12px;
      line-height: 1.5;
      color: #94a3b8;
