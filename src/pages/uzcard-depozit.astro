      padding-bottom: 90px;
      display: flex;
      justify-content: center;
    }
    .app-wrapper {
      max-width: 460px;
      width: 100%;
      margin: 0 auto;
      padding: 14px 14px 130px;
      background-color: #0b0e14;
    }

    /* Top Bar */
    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 14px;
    }
