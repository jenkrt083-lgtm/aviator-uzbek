    .hero-card::after {
      content: '💳';
      position: absolute;
      right: -8px;
      top: 10px;
      font-size: 88px;
      opacity: 0.16;
      pointer-events: none;
    }
    .hero-tag {
      display: inline-block;
      background: rgba(255, 255, 255, 0.18);
      backdrop-filter: blur(8px);
      color: #ffffff;
      font-size: 11px;
      font-weight: 800;
      padding: 4px 10px;
      border-radius: 12px;
      text-transform: uppercase;
      margin-bottom: 12px;
      letter-spacing: 0.5px;
    }
    .hero-title {
      font-size: 21px;
      font-weight: 900;
      line-height: 1.25;
      color: #ffffff;
      margin-bottom: 8px;
    }
    .hero-subtitle {
      font-size: 13px;
      line-height: 1.45;
      color: rgba(255, 255, 255, 0.88);
      margin-bottom: 16px;
