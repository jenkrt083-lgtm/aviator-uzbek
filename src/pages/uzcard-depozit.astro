---
const title = "Uzcard va Humo Orqali Aviatorga Pul Kiritish (2026)";
const description = "O'zbekistonda Aviator hisobini Uzcard va Humo orqali 10 000 so'mdan boshlab to'ldirish bo'yicha to'liq qo'llanma. 5 daqiqada depozit va pul yechish.";
const playLink = "/go/1win";

const schema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "Uzcard va Humo orqali Aviator hisobini to'ldirish",
  "step": [
    {
      "@type": "HowToStep",
      "name": "Ro'yxatdan o'tish",
      "text": "Rasmiy saytga kiring va 1 daqiqada hisob oching."
    },
    {
      "@type": "HowToStep",
      "name": "Kassani tanlash",
      "text": "Depozit bo'limiga o'ting va Uzcard yoki Humo to'lov tizimini tanlang."
    },
    {
      "@type": "HowToStep",
      "name": "Summani kiritish",
      "text": "Minimal 10 000 so'mdan boshlab summani yozing va to'lovni tasdiqlang."
    }
  ]
};
---

<!DOCTYPE html>
<html lang="uz">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background-color: #090d16;
      color: #f1f5f9;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 16px;
    }
    .container {
      max-width: 440px;
      margin: 0 auto;
      width: 100%;
      padding-top: 16px;
    }
    .nav-back {
      display: inline-block;
      color: #94a3b8;
      font-size: 13px;
      text-decoration: none;
      margin-bottom: 16px;
    }
    .badge {
      display: inline-block;
      background: rgba(16, 185, 129, 0.12);
      border: 1px solid rgba(16, 185, 129, 0.3);
      color: #34d399;
      font-size: 11px;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 9999px;
      margin-bottom: 12px;
    }
    h1 {
      font-size: 23px;
      line-height: 1.3;
      font-weight: 800;
      margin-bottom: 12px;
      text-align: center;
    }
    .btn-action {
      background: #10b981;
      color: #041f14;
      font-weight: 800;
      font-size: 16px;
      padding: 16px;
      border-radius: 16px;
      text-decoration: none;
      display: block;
      text-align: center;
      margin: 20px 0 24px;
      box-shadow: 0 10px 25px -5px rgba(16, 185, 129, 0.35);
    }
    .step-card {
      background: #0f172a;
      border: 1px solid #1e293b;
      border-radius: 16px;
      padding: 16px;
      margin-bottom: 14px;
    }
    .step-num {
      display: inline-block;
      background: #34d399;
      color: #041f14;
      font-size: 12px;
      font-weight: 800;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      text-align: center;
      line-height: 22px;
      margin-right: 8px;
    }
    .step-title {
      font-size: 15px;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 6px;
      display: flex;
      align-items: center;
    }
    .step-desc {
      font-size: 13px;
      color: #94a3b8;
      line-height: 1.5;
    }
    footer {
      text-align: center;
      font-size: 11px;
      color: #475569;
      padding: 16px 0;
    }
  </style>
</head>
<body>
  <main class="container">
    <a href="/" class="nav-back">← Asosiy sahifaga qaytish</a>
    <div style="text-align: center;">
      <span class="badge">💳 0% Komissiya bilan to'lov</span>
      <h1>Uzcard va Humo Orqali Hisobni To'ldirish</h1>
    </div>

    <a href={playLink} target="_blank" rel="nofollow sponsored" class="btn-action">
      💰 Hisobni To'ldirish va O'ynash
    </a>

    <div class="step-card">
      <div class="step-title">
        <span class="step-num">1</span> 1 daqiqada ro'yxatdan o'ting
      </div>
      <p class="step-desc">
        Saytga kiring va telefon raqamingiz orqali tezkor hisob oching. Valyuta sifatida <b>UZS (So'm)</b> tanlanadi.
      </p>
    </div>

    <div class="step-card">
      <div class="step-title">
        <span class="step-num">2</span> To'lov tizimini tanlang
      </div>
      <p class="step-desc">
        «Depozit» bo'limiga kiring. O'zbekiston bank kartalari uchun <b>Uzcard</b> yoki <b>Humo</b> variantini tanlang.
      </p>
    </div>

    <div class="step-card">
      <div class="step-title">
        <span class="step-num">3</span> Summani kiriting
      </div>
      <p class="step-desc">
        Minimal depozit — <b>10 000 so'm</b>. Mablag' hisobingizga bir necha soniya ichida komissiyasiz tushadi.
      </p>
    </div>
<div style="text-align: center; margin: 18px 0;">
      <a href="/ilova" style="color: #34d399; font-size: 13px; text-decoration: underline;">
        📲 O'yin uchun Android APK ilovasini yuklab olish →
      </a>
    </div>
  </main>

  <footer>
    © 2026 Aviator Uzbek. 18+ Mas'uliyat bilan o'ynang.
  </footer>
</body>
</html>
