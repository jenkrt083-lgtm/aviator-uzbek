      font-size: 12px;
      color: #cbd5e1;
      line-height: 1.5;
    }
    .alert-text a {
      color: #38bdf8;
      text-decoration: underline;
    }

    /* FAQ */
    .faq-title {
      font-size: 16px;
      font-weight: 800;
      color: #ffffff;
      margin: 20px 0 10px;
    }
    .faq-item {
      background: #141a24;
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 14px;
      margin-bottom: 8px;
      overflow: hidden;
