    .bottom-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-decoration: none;
      color: #708096;
      font-size: 10px;
      font-weight: 600;
      gap: 3px;
      flex: 1;
    }
    .bottom-item.active { color: #007aff; }
    .bottom-icon { font-size: 18px; }
