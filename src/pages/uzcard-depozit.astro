---
const title = "Uzcard va Humo Orqali Aviatorga Pul Kiritish (2026) — 1win";
const description = "O'zbekistonda Aviator hisobini Uzcard va Humo orqali 10 000 so'mdan boshlab 0% komissiya bilan to'ldirish bo'yicha to'liq qo'llanma.";
const playLink = "/go/1win";
const apkLink = "/download/apk";

const schema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "Uzcard va Humo orqali Aviator hisobini to'ldirish",
  "step": [
    {
      "@type": "HowToStep",
      "name": "Ro'yxatdan o'tish",
      "text": "1win rasmiy saytiga kiring va UZS valyutasida hisob oching."
    },
    {
      "@type": "HowToStep",
      "name": "Kassani tanlash",
      "text": "Depozit bo'limiga o'ting va Uzcard yoki Humo to'lov tizimini tanlang."
    },
    {
      "@type": "HowToStep",
      "name": "Summani kiritish",
      "text": "Minimal 10 000 so'mdan boshlab summani yozing va to'lovni tasdiqlang."
    }
  ]
};
---

<!DOCTYPE html>
<html lang="uz">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href="https://aviator-uzbek.online/uzcard-depozit" />
  <link rel="alternate" hreflang="uz" href="https://aviator-uzbek.online/uzcard-depozit" />
  <link rel="alternate" hreflang="ru" href="https://aviator-uzbek.online/ru-depozit" />
  <link rel="alternate" hreflang="x-default" href="https://aviator-uzbek.online/uzcard-depozit" />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="uz_UZ" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content="https://aviator-uzbek.online/uzcard-depozit" />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }
    body {
      background-color: #0b0e14;
      color: #f1f5f9;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      min-height: 100vh;
      padding-bottom: 84px;
    }
    .app-wrapper {
      max-width: 460px;
      margin: 0 auto;
      padding: 14px 14px 20px;
    }
    .top-chips {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding-bottom: 14px;
      scrollbar-width: none;
    }
    .top-chips::-webkit-scrollbar { display: none; }
    .chip {
      background: #171d28;
      color: #94a3b8;
      font-size: 13px;
      font-weight: 700;
      padding: 8px 16px;
      border-radius: 20px;
      white-space: nowrap;
      text-decoration: none;
      border: 1px solid rgba(255, 255, 255, 0.05);
    }
    .chip.active {
      background: #007aff;
      color: #ffffff;
      border-color: #007aff;
      box-shadow: 0 4px 12px rgba(0, 122, 255, 0.35);
    }
    .hero-card {
      background: linear-gradient(145deg, #0738b8 0%, #0056e0 50%, #007aff 100%);
      border-radius: 24px;
      padding: 22px 18px 20px;
      position: relative;
      overflow: hidden;
      margin-bottom: 14px;
      box-shadow: 0 12px 28px rgba(0, 86, 224, 0.25);
    }
    .hero-card::after {
      content: '💳';
      position: absolute;
      right: -8px;
      top: 10px;
      font-size: 88px;
      opacity: 0.18;
      pointer-events: none;
    }
    .hero-tag {
      display: inline-block;
      background: rgba(255, 255, 255, 0.18);
      backdrop-filter: blur(8px);
      color: #ffffff;
      font-size: 11px;
      font-weight: 800;
      padding: 4px 10px;
      border-radius: 12px;
      text-transform: uppercase;
      margin-bottom: 12px;
    }
    .hero-title {
      font-size: 22px;
      font-weight: 900;
      line-height: 1.25;
      color: #ffffff;
      margin-bottom: 8px;
    }
    .hero-subtitle {
      font-size: 13px;
      color: rgba(255, 255, 255, 0.85);
      line-height: 1.45;
      margin-bottom: 20px;
      max-width: 85%;
    }
    .btn-deposit {
      background: #ffffff;
      color: #0738b8;
      font-weight: 800;
      font-size: 16px;
      text-align: center;
      padding: 15px;
      border-radius: 16px;
      display: block;
      text-decoration: none;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.15);
    }

    .step-box {
      background: linear-gradient(145deg, #102434 0%, #0d1e2d 100%);
      border: 1px solid #1a2f42;
      border-radius: 20px;
      padding: 16px;
      margin-bottom: 12px;
    }
    .step-header {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 6px;
    }
    .step-badge {
      background: #007aff;
      color: #ffffff;
      font-weight: 800;
      font-size: 12px;
      width: 24px;
      height: 24px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .step-title {
      font-size: 15px;
      font-weight: 800;
      color: #ffffff;
    }
    .step-desc {
      font-size: 13px;
      color: #8fa0b5;
      line-height: 1.5;
      padding-left: 34px;
    }

    .info-card {
      background: #111722;
      border: 1px solid #1c2637;
      border-radius: 20px;
      padding: 16px 18px;
      margin: 16px 0 24px;
    }
    .info-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      font-size: 13px;
    }
    .info-row:last-child {
      border-bottom: none;
      padding-bottom: 2px;
    }
    .info-label { color: #76879d; }
    .info-val-green { font-weight: 800; color: #10b981; }
    .info-val { font-weight: 700; color: #ffffff; }

    footer {
      text-align: center;
      font-size: 11px;
      color: #4f5f73;
      padding: 10px 0 20px;
    }
    footer a {
      color: #64748b;
      text-decoration: underline;
      margin: 0 6px;
    }

    .bottom-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: #0f141d;
      border-top: 1px solid #1c2433;
      height: 64px;
      display: flex;
      justify-content: space-around;
      align-items: center;
      z-index: 100;
      box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.4);
    }
    .bottom-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-decoration: none;
      color: #708096;
      font-size: 10px;
      font-weight: 600;
      gap: 3px;
      flex: 1;
    }
    .bottom-item.active { color: #007aff; }
    .bottom-icon { font-size: 18px; }
  </style>
</head>
<body>

  <div class="app-wrapper">
    <div class="top-chips">
      <a href="/" class="chip">🚀 Aviator</a>
      <a href="/ilova" class="chip">📲 APK Ilova</a>
      <span class="chip active">💳 Uzcard / Humo</span>
      <a href={playLink} target="_blank" rel="nofollow sponsored" class="chip">🎁 +500% Bonus</a>
    </div>

    <div class="hero-card">
      <div class="hero-tag">💳 0% Komissiya bilan to'lov</div>
      <h1 class="hero-title">Uzcard va Humo Orqali Hisobni To'ldirish</h1>
      <p class="hero-subtitle">10 000 so'mdan boshlab darhol hisobga tushadi. 5 daqiqada yechib olish kafolati.</p>
      <a href={playLink} target="_blank" rel="nofollow sponsored" class="btn-deposit">
        💰 Hisobni To'ldirish va O'ynash
      </a>
    </div>

    <div class="step-box">
      <div class="step-header">
        <span class="step-badge">1</span>
        <span class="step-title">Ro'yxatdan o'ting</span>
      </div>
      <p class="step-desc">
        Saytga kiring va telefon raqamingiz orqali 1 daqiqada hisob oching. Valyuta sifatida <b>UZS (So'm)</b> tanlanadi.
      </p>
    </div>

    <div class="step-box">
      <div class="step-header">
        <span class="step-badge">2</span>
        <span class="step-title">To'lov usulini tanlang</span>
      </div>
      <p class="step-desc">
        «Depozit» bo'limida <b>Uzcard</b> yoki <b>Humo</b> tugmasini bosing.
      </p>
    </div>

    <div class="step-box">
      <div class="step-header">
        <span class="step-badge">3</span>
        <span class="step-title">Summani tasdiqlang</span>
      </div>
      <p class="step-desc">
        Minimal summa — <b>10 000 so'm</b>. Mablag' hech qanday komissiyasiz balansingizda paydo bo'ladi.
      </p>
    </div>

    <div class="info-card">
      <div class="info-row">
        <span class="info-label">Minimal depozit:</span>
        <span class="info-val-green">10 000 so'm</span>
      </div>
      <div class="info-row">
        <span class="info-label">Pul tushish vaqti:</span>
        <span class="info-val">Darhol (0 soniya)</span>
      </div>
      <div class="info-row">
        <span class="info-label">Pul yechish:</span>
        <span class="info-val">5-15 daqiqa</span>
      </div>
    </div>

    <div class="info-card">
      <div class="info-row">
        <span class="info-label">CLICK / Payme:</span>
        <span class="info-val">ham ishlaydi, 2-3 daqiqada</span>
      </div>
      <div class="info-row">
        <span class="info-label">Mening sinovim:</span>
        <span class="info-val-green">Humo 7 daq, Uzcard 12 daq yechish</span>
      </div>
    </div>

    <div class="step-box">
      <div class="step-header"><span class="step-badge">!</span><span class="step-title">Pul kelmasa — tekshiring</span></div>
      <p class="step-desc">Karta raqam, SMS kod, Kassa tarixi. Kechqurun 15 daqiqagacha cho'ziladi. 30 daqiqadan oshsa ID + чек bilan supportga yozing. <a href="/strategiya" style="color:#fff;">Strategiya</a> da bankni bo'lish qoidasi ham bor.</p>
    </div>

    <footer>
      <div style="margin-bottom: 8px;">
        <a href="/masuliyatli-oyin">Mas'uliyatli o'yin (18+)</a>
        <a href="/maxfiylik-siyosati">Maxfiylik siyosati</a>
      </div>
      © 2026 Aviator Uzbek. 18+ Mas'uliyat bilan o'ynang.
    </footer>
  </div>

  <nav class="bottom-bar">
    <a href="/" class="bottom-item">
      <span class="bottom-icon">🏠</span>
      <span>Asosiy</span>
    </a>
    <a href={playLink} target="_blank" rel="nofollow sponsored" class="bottom-item">
      <span class="bottom-icon">✈️</span>
      <span>Aviator</span>
    </a>
    <a href="/ilova" class="bottom-item">
      <span class="bottom-icon">📲</span>
      <span>APK</span>
    </a>
    <a href="/uzcard-depozit" class="bottom-item active">
      <span class="bottom-icon">💳</span>
      <span>To'lov</span>
    </a>
    <a href={playLink} target="_blank" rel="nofollow sponsored" class="bottom-item">
      <span class="bottom-icon">🎁</span>
      <span>Bonus</span>
    </a>
  </nav>

</body>
</html>
