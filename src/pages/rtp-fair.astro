{ "@type": "Question", "name": "RTP 97% kafolatmi?", "acceptedAnswer": { "@type": "Answer", "text": "Yo'q. Bu millionlab raunddagi o'rtacha. Men bir oqshomda minusda, ertasi plusda bo'lganman." } },
{ "@type": "Question", "name": "Provably Fair qanday ishlaydi?", "acceptedAnswer": { "@type": "Answer", "text": "Har raundda hash bo'ladi, natijani keyin tekshirish mumkin. 1win da raund tarixida ko'rinadi." } },
{ "@type": "Question", "name": "Spribe kim?", "acceptedAnswer": { "@type": "Answer", "text": "Aviator yaratuvchisi, 2019 yil. Crash o'yinlar bo'yicha tanilgan provayder." } }
]};
