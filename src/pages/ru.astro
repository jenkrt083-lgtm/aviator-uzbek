  <script>
    let currentBet = 10000;
    let isRunning = false;
    let multiplier = 1.0;
    let interval = null;
    let crashPoint = 2.0;

    const multEl = document.getElementById('sim-mult');
    const statusEl = document.getElementById('sim-status');
    const planeEl = document.getElementById('sim-plane');
    const btnEl = document.getElementById('sim-btn');
    const resultBox = document.getElementById('sim-result');
    const resultText = document.getElementById('sim-result-text');
    const chipBtns = document.querySelectorAll('.sim-chip-btn');

    chipBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        if (isRunning) return;
        chipBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentBet = parseInt(btn.dataset.bet || '10000', 10);
      });
    });

    btnEl?.addEventListener('click', () => {
      if (!isRunning) {
        isRunning = true;
        multiplier = 1.0;
        resultBox.style.display = 'none';
        btnEl.classList.add('cashing');
        btnEl.textContent = "💰 Забрать Выигрыш";
        statusEl.textContent = "Самолет в полете...";
        statusEl.style.color = "#34d399";
        
        crashPoint = (Math.random() * 4.2 + 1.3);

        interval = setInterval(() => {
          multiplier += 0.02 * (multiplier * 0.4);
          multEl.textContent = multiplier.toFixed(2) + 'x';

          const progress = Math.min((multiplier - 1) / 3, 1);
          planeEl.style.bottom = (20 + progress * 70) + 'px';
          planeEl.style.left = (20 + progress * 240) + 'px';

          if (multiplier >= crashPoint) {
            clearInterval(interval);
            isRunning = false;
            btnEl.classList.remove('cashing');
            btnEl.textContent = "🔄 Попробовать Снова";
            statusEl.textContent = "Самолет улетел!";
            statusEl.style.color = "#ef4444";
            multEl.style.color = "#ef4444";
            planeEl.style.transform = "rotate(-25deg) translateY(-80px)";
            planeEl.style.opacity = "0";

            setTimeout(() => {
              planeEl.style.transform = "none";
              planeEl.style.opacity = "1";
              planeEl.style.bottom = "20px";
              planeEl.style.left = "20px";
              multEl.style.color = "#ffffff";
            }, 1000);
          }
        }, 50);

      } else {
        clearInterval(interval);
        isRunning = false;
        btnEl.classList.remove('cashing');
        btnEl.textContent = "🚀 Играть Еще Раз";
        statusEl.textContent = "Выигрыш зафиксирован!";
        statusEl.style.color = "#10b981";

        const wonAmount = Math.round(currentBet * multiplier).toLocaleString('ru-RU');
        resultText.innerHTML = `Поздравляем! Ваш выигрыш: <b>${wonAmount} сум</b>! 🎉`;
        resultBox.style.display = 'block';
      }
    });
  </script>

