      <div style="margin-bottom: 8px;">
        <a href="/ru-otvetstvennaya-igra/">Ответственная игра (18+)</a>
        <a href="/ru-politika/">Политика конфиденциальности</a>
      </div>
      © 2026 Авиатор Узбекистан. 18+ Играйте ответственно. Азартные игры несут финансовый риск.
    </footer>

  </div>

  <!-- Bottom Navigation Bar -->
  <nav class="bottom-bar">
    <a href="/ru/" class="bottom-item active">
      <span class="bottom-icon">🏠</span>
      <span>Главная</span>
    </a>
    <a href={refLink} target="_blank" rel="nofollow sponsored" class="bottom-item">
      <span class="bottom-icon">✈️</span>
      <span>Авиатор</span>
    </a>
    <a href="/ru-apk/" class="bottom-item">
      <span class="bottom-icon">📲</span>
      <span>APK</span>
    </a>
    <a href="/ru-depozit/" class="bottom-item">
      <span class="bottom-icon">💳</span>
      <span>Депозит</span>
    </a>
    <a href={refLink} target="_blank" rel="nofollow sponsored" class="bottom-item">
      <span class="bottom-icon">🎁</span>
      <span>Бонус</span>
    </a>
  </nav>

<!-- Interactive JavaScript -->
  <script>
    // ==========================================
    // 1. AUTHENTIC SPRIBE AVIATOR CANVAS ENGINE
    // ==========================================
    const canvas = document.getElementById('aviator-canvas');
    const ctx = canvas.getContext('2d');
    const multText = document.getElementById('mult-text');
    const flewText = document.getElementById('flew-text');
    const waitingLabel = document.getElementById('waiting-label');
    const waitingBarWrap = document.getElementById('waiting-bar-wrap');
    const waitingBarFill = document.getElementById('waiting-bar-fill');
    const actionBtn = document.getElementById('btn-action');
    const mainLabel = document.getElementById('btn-main-label');
    const subLabel = document.getElementById('btn-sub-label');
    const winBanner = document.getElementById('win-banner');
    const winBannerText = document.getElementById('win-banner-text');
    const balDisplay = document.getElementById('bal-val');
    const historyBar = document.getElementById('history-bar');

    let virtualBal = 1000000;
    let currentBet = 10000;
    let autoCashoutVal = 2.00;
    let isAutoMode = false;

    let gameState = 'IDLE'; // IDLE, WAITING, FLYING, CRASHED, WON
    let currentMult = 1.00;
    let crashTarget = 2.00;
    let animId = null;
    let flightStartTime = 0;
    let propAngle = 0;

    function resizeCanvas() {
      const rect = canvas.getBoundingClientRect();
      canvas.width = rect.width * window.devicePixelRatio;
      canvas.height = rect.height * window.devicePixelRatio;
      ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    // Draw Dark Arena Grid (Fine Spribe Grid)
    function drawGrid() {
      const w = canvas.width / window.devicePixelRatio;
      const h = canvas.height / window.devicePixelRatio;
      ctx.clearRect(0, 0, w, h);

      // Deep dark arena background
      ctx.fillStyle = '#0a0d14';
      ctx.fillRect(0, 0, w, h);

      // Grid lines
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.04)';
      ctx.lineWidth = 1;
      for (let x = 0; x < w; x += 32) {
        ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, h); ctx.stroke();
      }
      for (let y = 0; y < h; y += 32) {
        ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(w, y); ctx.stroke();
      }

      // X & Y Axis markings
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.08)';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(20, 0); ctx.lineTo(20, h - 20); ctx.lineTo(w, h - 20);
      ctx.stroke();
    }

    // DRAW THE ICONIC SPRIBE RED PROPELLER AIRPLANE
    function drawAviatorPlane(x, y, angle, propRot) {
      ctx.save();
      ctx.translate(x, y);
      ctx.rotate(angle);

      const s = 1.05;
      ctx.scale(s, s);

      // Soft ground/air shadow
      ctx.save();
      ctx.fillStyle = 'rgba(0, 0, 0, 0.35)';
      ctx.beginPath();
      ctx.ellipse(0, 16, 22, 6, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();

      // Rear horizontal stabilizer
      ctx.fillStyle = '#991b1b';
      ctx.beginPath();
      ctx.moveTo(-20, -2);
      ctx.lineTo(-28, -8);
      ctx.lineTo(-23, -2);
      ctx.lineTo(-28, 6);
      ctx.closePath();
      ctx.fill();

      // Tail fin (vertical rudder)
      ctx.fillStyle = '#dc2626';
      ctx.beginPath();
      ctx.moveTo(-16, -3);
      ctx.lineTo(-25, -16);
      ctx.lineTo(-20, -16);
      ctx.lineTo(-12, -3);
      ctx.closePath();
      ctx.fill();

      // Main lower wing
      ctx.fillStyle = '#7f1d1d';
      ctx.beginPath();
      ctx.moveTo(-2, 0);
      ctx.lineTo(-8, 13);
      ctx.lineTo(-1, 13);
      ctx.lineTo(8, 0);
      ctx.closePath();
      ctx.fill();

      // Main Fuselage (Curved Red Aerodynamic Body)
      const bodyGrad = ctx.createLinearGradient(0, -9, 0, 9);
      bodyGrad.addColorStop(0, '#f87171');
      bodyGrad.addColorStop(0.3, '#dc2626');
      bodyGrad.addColorStop(1, '#991b1b');

      ctx.fillStyle = bodyGrad;
      ctx.beginPath();
      ctx.moveTo(22, 0); // nose
      ctx.quadraticCurveTo(12, -8, -16, -5);
      ctx.lineTo(-22, -2);
      ctx.lineTo(-22, 2);
      ctx.quadraticCurveTo(-10, 7, 12, 5);
      ctx.closePath();
      ctx.fill();

      // White fuselage racing stripe
      ctx.strokeStyle = '#ffffff';
      ctx.lineWidth = 1.4;
      ctx.beginPath();
      ctx.moveTo(14, -1);
      ctx.quadraticCurveTo(0, -1.5, -16, -2);
      ctx.stroke();

      // Cockpit window / canopy
      ctx.fillStyle = '#38bdf8';
      ctx.beginPath();
      ctx.moveTo(6, -4);
      ctx.quadraticCurveTo(0, -9, -7, -5);
      ctx.quadraticCurveTo(0, -3, 6, -4);
      ctx.fill();
      ctx.strokeStyle = '#0284c7';
      ctx.lineWidth = 0.8;
      ctx.stroke();

      // Upper main wing
      ctx.fillStyle = '#ef4444';
      ctx.beginPath();
      ctx.moveTo(-2, -3);
      ctx.lineTo(-8, -16);
      ctx.lineTo(-1, -16);
      ctx.lineTo(10, -3);
      ctx.closePath();
      ctx.fill();

      // White tip on upper wing
      ctx.fillStyle = '#ffffff';
      ctx.beginPath();
      ctx.moveTo(-8, -16);
      ctx.lineTo(-1, -16);
      ctx.lineTo(-3, -13);
      ctx.lineTo(-7, -13);
      ctx.closePath();
      ctx.fill();

      // Propeller Hub (Nose Cone)
      ctx.fillStyle = '#0f172a';
      ctx.beginPath();
      ctx.arc(22, 0, 3.5, 0, Math.PI * 2);
      ctx.fill();

      // Animated Spinning Propeller Blades & Motion Blur
      ctx.save();
      ctx.translate(23, 0);
      ctx.rotate(propRot);

      // Blades
      ctx.fillStyle = 'rgba(255, 255, 255, 0.6)';
      ctx.beginPath();
      ctx.ellipse(0, 0, 1.5, 14, 0, 0, Math.PI * 2);
      ctx.fill();

      // Motion blur circle
      ctx.fillStyle = 'rgba(255, 255, 255, 0.16)';
      ctx.beginPath();
      ctx.arc(0, 0, 14, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();

      ctx.restore();
    }

    // RENDER CURVE AND AIRPLANE
    function renderFlightScene(progress, isCrash, planeOffset) {
      const w = canvas.width / window.devicePixelRatio;
      const h = canvas.height / window.devicePixelRatio;

      drawGrid();

      if (gameState === 'IDLE') {
        // Idle plane resting on runway
        drawAviatorPlane(40, h - 35, 0, propAngle);
        return;
      }

      if (gameState === 'WAITING') {
        drawAviatorPlane(40, h - 35, 0, propAngle);
        return;
      }

      const startX = 20;
      const startY = h - 20;
      const endX = startX + progress * (w - 75);
      const endY = startY - Math.pow(progress, 1.35) * (h - 75) + planeOffset.y;

      // 1. Area Gradient Fill under red curve (True Spribe Look)
      const grad = ctx.createLinearGradient(0, endY, 0, startY);
      if (isCrash) {
        grad.addColorStop(0, 'rgba(153, 27, 27, 0.35)');
        grad.addColorStop(1, 'rgba(153, 27, 27, 0.0)');
      } else {
        grad.addColorStop(0, 'rgba(225, 29, 72, 0.45)');
        grad.addColorStop(1, 'rgba(225, 29, 72, 0.0)');
      }

      ctx.beginPath();
      ctx.moveTo(startX, startY);
      ctx.quadraticCurveTo(startX + (endX - startX) * 0.45, startY, endX, endY);
      ctx.lineTo(endX, startY);
      ctx.closePath();
      ctx.fillStyle = grad;
      ctx.fill();

      // 2. Glowing Red Trajectory Line
      ctx.beginPath();
      ctx.moveTo(startX, startY);
      ctx.quadraticCurveTo(startX + (endX - startX) * 0.45, startY, endX, endY);
      ctx.strokeStyle = isCrash ? '#991b1b' : '#e11d48';
      ctx.lineWidth = 3.8;
      ctx.shadowColor = '#e11d48';
      ctx.shadowBlur = isCrash ? 4 : 14;
      ctx.stroke();
      ctx.shadowBlur = 0;

      // 3. Draw Plane
      if (!isCrash) {
        const baseAngle = -0.32 - progress * 0.16 + planeOffset.rot;
        drawAviatorPlane(endX, endY, baseAngle, propAngle);
      } else {
        // Plane zooms away into top right
        const crashX = endX + planeOffset.crashX;
        const crashY = endY + planeOffset.crashY;
        drawAviatorPlane(crashX, crashY, -0.65, propAngle);
      }
    }

    drawGrid();
    drawAviatorPlane(40, (canvas.height / window.devicePixelRatio) - 35, 0, 0);

    // ==========================================
    // 2. ROUND CONTROLLER & FLIGHT DYNAMICS
    // ==========================================
    function triggerNextRound() {
      if (virtualBal < currentBet) {
        alert("Недостаточно средств на балансе! Balans 1 000 000 сумga yangilandi.");
        virtualBal = 1000000;
        balDisplay.textContent = virtualBal.toLocaleString('uz-UZ') + " сум";
      }

      virtualBal -= currentBet;
      balDisplay.textContent = virtualBal.toLocaleString('uz-UZ') + " сум";
      winBanner.style.display = 'none';
      flewText.style.display = 'none';

      gameState = 'WAITING';
      actionBtn.className = 'btn-aviator-action state-waiting';
      mainLabel.textContent = "ОЖИДАНИЕ...";
      subLabel.textContent = "Приготовьтесь";

      waitingLabel.style.display = 'block';
      waitingBarWrap.style.display = 'block';
      waitingBarFill.style.width = '0%';

      multText.textContent = "1.00x";
      multText.style.color = "#ffffff";

      let waitProgress = 0;
      const waitInterval = setInterval(() => {
        waitProgress += 2.5;
        waitingBarFill.style.width = waitProgress + '%';
        propAngle += 0.3;
        renderFlightScene(0, false, { y: 0, rot: 0 });

        if (waitProgress >= 100) {
          clearInterval(waitInterval);
          waitingLabel.style.display = 'none';
          waitingBarWrap.style.display = 'none';
          launchFlight();
        }
      }, 75);
    }

    function launchFlight() {
      gameState = 'FLYING';
      currentMult = 1.00;
      flightStartTime = performance.now();

      // Weighted crash target (RTP 97% model)
      const r = Math.random();
      if (r < 0.04) crashTarget = 1.00;
      else if (r < 0.52) crashTarget = 1.15 + Math.random() * 0.85;
      else if (r < 0.83) crashTarget = 2.00 + Math.random() * 2.20;
      else if (r < 0.95) crashTarget = 4.20 + Math.random() * 5.00;
      else crashTarget = 9.20 + Math.random() * 25.0;

      actionBtn.className = 'btn-aviator-action state-cashout';
      mainLabel.textContent = "ЗАБРАТЬ ВЫИГРЫШ";
      updateCashoutDisplay();

      function gameLoop(now) {
        const elapsed = (now - flightStartTime) / 1000;
        
        // Multiplier progression curve
        currentMult = 1.00 + Math.pow(elapsed * 0.72, 1.48);
        multText.textContent = currentMult.toFixed(2) + 'x';

        // Organic flight turbulence
        const turbulenceY = Math.sin(elapsed * 6.5) * 3.5;
        const turbulenceRot = Math.sin(elapsed * 4.5) * 0.04;
        propAngle += 0.8;

        // Auto cashout check
        if (isAutoMode && currentMult >= autoCashoutVal && gameState === 'FLYING') {
          handleCashOut();
          return;
        }

        // Crash check
        if (currentMult >= crashTarget) {
          handleCrash();
          return;
        }

        const progress = Math.min(elapsed / 6.5, 1);
        renderFlightScene(progress, false, { y: turbulenceY, rot: turbulenceRot });
        updateCashoutDisplay();

        if (gameState === 'FLYING') {
          animId = requestAnimationFrame(gameLoop);
        }
      }
      animId = requestAnimationFrame(gameLoop);
    }

    function updateCashoutDisplay() {
      if (gameState !== 'FLYING') return;
      const currentWin = Math.round(currentBet * currentMult);
      subLabel.textContent = currentWin.toLocaleString('uz-UZ') + " сум";
    }

    function handleCashOut() {
      gameState = 'WON';
      cancelAnimationFrame(animId);
      const winAmt = Math.round(currentBet * currentMult);
      virtualBal += winAmt;
      balDisplay.textContent = virtualBal.toLocaleString('uz-UZ') + " сум";

      actionBtn.className = 'btn-aviator-action state-bet';
      mainLabel.textContent = "ПОСТАВИТЬ СТАВКУ";
      subLabel.textContent = currentBet.toLocaleString('uz-UZ') + " сум";

      winBannerText.innerHTML = "🎉 Поздравляем! Вы выиграли <b>" + winAmt.toLocaleString('uz-UZ') + " сум</b>  (" + currentMult.toFixed(2) + "x x)!";
      winBanner.style.display = 'block';

      // Keep flight scene frozen at won multiplier
      const elapsed = (performance.now() - flightStartTime) / 1000;
      const progress = Math.min(elapsed / 6.5, 1);
      renderFlightScene(progress, false, { y: 0, rot: 0 });
    }

    function handleCrash() {
      gameState = 'CRASHED';
      cancelAnimationFrame(animId);

      multText.textContent = crashTarget.toFixed(2) + 'x';
      multText.style.color = '#e11d48';
      flewText.style.display = 'block';

      // Add to history ribbon
      addHistoryPill(crashTarget);

      actionBtn.className = 'btn-aviator-action state-bet';
      mainLabel.textContent = "ПОВТОРИТЬ СТАВКУ";
      subLabel.textContent = currentBet.toLocaleString('uz-UZ') + " сум";

      // Animate plane zooming off
      let crashFlyProgress = 0;
      function zoomAway() {
        crashFlyProgress += 1;
        const elapsed = (performance.now() - flightStartTime) / 1000;
        const progress = Math.min(elapsed / 6.5, 1);
        renderFlightScene(progress, true, { 
          crashX: crashFlyProgress * 12, 
          crashY: -crashFlyProgress * 8 
        });

        if (crashFlyProgress < 25) {
          requestAnimationFrame(zoomAway);
        }
      }
      zoomAway();
    }

    function addHistoryPill(val) {
      const pill = document.createElement('span');
      pill.className = 'history-pill ' + (val < 2 ? 'pill-blue' : (val < 10 ? 'pill-purple' : 'pill-gold'));
      pill.textContent = val.toFixed(2) + 'x';
      historyBar.insertBefore(pill, historyBar.firstChild);
      if (historyBar.children.length > 12) {
        historyBar.removeChild(historyBar.lastChild);
      }
    }

    // Action Button Click
    actionBtn.addEventListener('click', () => {
      if (gameState === 'IDLE' || gameState === 'CRASHED' || gameState === 'WON') {
        triggerNextRound();
      } else if (gameState === 'FLYING') {
        handleCashOut();
      }
    });

    // Bet Stepper & Chips
    const betDisp = document.getElementById('bet-disp');
    const chipBtns = document.querySelectorAll('.bet-chip');

    function setBet(amount) {
      if (gameState === 'FLYING' || gameState === 'WAITING') return;
      currentBet = Math.max(5000, Math.min(1000000, amount));
      betDisp.textContent = currentBet.toLocaleString('uz-UZ') + " сум";
      if (gameState !== 'FLYING') {
        subLabel.textContent = currentBet.toLocaleString('uz-UZ') + " сум";
      }
      chipBtns.forEach(c => {
        if (parseInt(c.dataset.amt, 10) === currentBet) c.classList.add('active');
        else c.classList.remove('active');
      });
    }

    document.getElementById('btn-plus').addEventListener('click', () => setBet(currentBet + 5000));
    document.getElementById('btn-minus').addEventListener('click', () => setBet(currentBet - 5000));

    chipBtns.forEach(c => {
      c.addEventListener('click', () => setBet(parseInt(c.dataset.amt, 10)));
    });

    // Bet / Auto Mode Tab Switch
    const tabBet = document.getElementById('tab-bet');
    const tabAuto = document.getElementById('tab-auto');
    const autoRow = document.getElementById('auto-options-row');
    const autoDisp = document.getElementById('auto-val-disp');

    tabBet.addEventListener('click', () => {
      tabBet.classList.add('active');
      tabAuto.classList.remove('active');
      autoRow.classList.remove('active');
      isAutoMode = false;
    });

    tabAuto.addEventListener('click', () => {
      tabAuto.classList.add('active');
      tabBet.classList.remove('active');
      autoRow.classList.add('active');
      isAutoMode = true;
    });

    document.getElementById('btn-auto-plus').addEventListener('click', () => {
      autoCashoutVal = Math.min(20, Math.round((autoCashoutVal + 0.10) * 100) / 100);
      autoDisp.textContent = autoCashoutVal.toFixed(2) + 'x';
    });

    document.getElementById('btn-auto-minus').addEventListener('click', () => {
      autoCashoutVal = Math.max(1.10, Math.round((autoCashoutVal - 0.10) * 100) / 100);
      autoDisp.textContent = autoCashoutVal.toFixed(2) + 'x';
    });

    // ==========================================
    // 3. PROBABILITY CALCULATOR LOGIC
    // ==========================================
    const slider = document.getElementById('prob-slider');
    const coeffDisp = document.getElementById('coeff-display');
    const probDisp = document.getElementById('prob-display');
    const presetBtns = document.querySelectorAll('.btn-preset');

    function updateProb(val) {
      const coeff = parseFloat(val);
      coeffDisp.textContent = coeff.toFixed(2) + 'x';
      // Official Aviator RTP = 97%
      const prob = (97 / coeff).toFixed(1);
      probDisp.textContent = prob + '%';
    }

    slider?.addEventListener('input', (e) => {
      presetBtns.forEach(b => b.classList.remove('active'));
      updateProb(e.target.value);
    });

    presetBtns.forEach(b => {
      b.addEventListener('click', () => {
        presetBtns.forEach(btn => btn.classList.remove('active'));
        b.classList.add('active');
        const v = parseFloat(b.dataset.v);
        slider.value = v;
        updateProb(v);
      });
    });

  </script>
</body>
