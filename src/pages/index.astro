---
const title = "Aviator O'yini Uzbekistan (2026) — Rasmiy Sayt va Signallar";
const description = "O'zbekistonda Aviator o'yinida yutish sirlari, 1win rasmiy kirish va Uzcard/Humo orqali 10 000 so'mdan depozit qilish.";
const refLink = "/go/1win";
---

<!DOCTYPE html>
<html lang="uz">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-950 text-slate-100 font-sans antialiased min-h-screen flex flex-col justify-between p-4">
  <main class="max-w-md mx-auto w-full pt-8 text-center">
    <div class="inline-block bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider mb-4">
      ⚡️ Rasmiy va Yangilangan Versiya 2026
    </div>
    
    <h1 class="text-3xl font-extrabold leading-tight mb-3">
      Aviator O'yini — O'zbekistonda Pul Ishlash Sirlari
    </h1>
    
    <p class="text-slate-400 text-sm mb-6">
      Uzcard va Humo orqali to'lovlar, tezkor pul yechib olish va yangi o'yinchilar uchun +500% xush kelibsiz bonusi.
    </p>

    <div class="space-y-3 mb-8">
      <a href={refLink} target="_blank" rel="nofollow sponsored" 
         class="block w-full bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-bold py-4 px-6 rounded-2xl text-lg shadow-lg shadow-emerald-500/25 transition">
        🚀 O'yinni Boshlash (+500% Bonus)
      </a>
      <a href={refLink} target="_blank" rel="nofollow sponsored" 
         class="block w-full bg-slate-900 border border-slate-800 hover:bg-slate-800 text-white font-semibold py-3.5 px-6 rounded-2xl transition text-sm">
        📲 Android APK Yuklab Olish (45 MB)
      </a>
    </div>

    <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-4 text-left text-sm space-y-2.5">
      <div class="flex justify-between border-b border-slate-800/60 pb-2">
        <span class="text-slate-400">Minimal depozit:</span>
        <span class="font-medium text-emerald-400">10 000 so'm</span>
      </div>
      <div class="flex justify-between border-b border-slate-800/60 pb-2">
        <span class="text-slate-400">To'lov tizimlari:</span>
        <span class="font-medium">Uzcard, Humo, Visa</span>
      </div>
      <div class="flex justify-between">
        <span class="text-slate-400">Pul yechish vaqti:</span>
        <span class="font-medium">5-15 daqiqa</span>
      </div>
    </div>
  </main>

  <footer class="text-center text-xs text-slate-600 py-4">
    © 2026 Aviator Uzbek. 18+ Mas'uliyat bilan o'ynang.
  </footer>
</body>
</html>
