---
<!DOCTYPE html>
<html lang="uz">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="uz" href="https://aviator-uzbek.online/" />
  <link rel="alternate" hreflang="ru" href="https://aviator-uzbek.online/ru/" />
  <link rel="alternate" hreflang="x-default" href="https://aviator-uzbek.online/" />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="uz_UZ" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content="https://aviator-uzbek.online/og-preview.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="https://aviator-uzbek.online/og-preview.png" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
<style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }
    body {
      background-color: #0b0e14;
      color: #f1f5f9;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      min-height: 100vh;
      padding-bottom: 90px;
      display: flex;
      justify-content: center;
    }
    .app-wrapper {
      max-width: 460px;
      width: 100%;
      margin: 0 auto;
      padding: 14px 14px 20px;
      background-color: #0b0e14;
    }

    /* Top Bar with Logo & Lang Switcher */
    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 14px;
    }
    .logo {
      display: flex;
      align-items: center;
      gap: 7px;
      font-size: 19px;
      font-weight: 900;
      color: #ffffff;
      text-decoration: none;
      letter-spacing: -0.3px;
    }
    .lang-bar {
      display: flex;
      gap: 6px;
    }
    .lang-btn {
      font-size: 11px;
      font-weight: 700;
      padding: 5px 11px;
      border-radius: 8px;
      text-decoration: none;
      color: #94a3b8;
      background: #171d28;
      border: 1px solid rgba(255, 255, 255, 0.05);
      transition: all 0.2s;
    }
    .lang-btn.active {
      background: #007aff;
      color: #ffffff;
      border-color: #007aff;
    }

    /* Top Chips */
    .top-chips {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding-bottom: 14px;
      scrollbar-width: none;
    }
    .top-chips::-webkit-scrollbar { display: none; }
    .chip {
      background: #171d28;
      color: #94a3b8;
      font-size: 13px;
      font-weight: 700;
      padding: 8px 16px;
      border-radius: 20px;
      white-space: nowrap;
      text-decoration: none;
      border: 1px solid rgba(255, 255, 255, 0.05);
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }
    .chip.active {
      background: #007aff;
      color: #ffffff;
      border-color: #007aff;
      box-shadow: 0 4px 12px rgba(0, 122, 255, 0.35);
    }

    /* Hero Card (Original Vibrant Blue Casino Gradient) */
    .hero-card {
      background: linear-gradient(145deg, #0738b8 0%, #0056e0 50%, #007aff 100%);
      border-radius: 24px;
      padding: 22px 18px 20px;
      position: relative;
      overflow: hidden;
      margin-bottom: 16px;
      box-shadow: 0 12px 28px rgba(0, 86, 224, 0.28);
    }
    .hero-card::after {
      content: '✈️';
      position: absolute;
      right: -8px;
      top: 10px;
      font-size: 88px;
      opacity: 0.16;
      pointer-events: none;
    }
    .hero-tag {
      display: inline-block;
      background: rgba(255, 255, 255, 0.18);
      backdrop-filter: blur(8px);
      color: #ffffff;
      font-size: 11px;
      font-weight: 800;
      padding: 4px 10px;
      border-radius: 12px;
      text-transform: uppercase;
      margin-bottom: 12px;
      letter-spacing: 0.5px;
    }
    .hero-title {
      font-size: 22px;
      font-weight: 900;
      line-height: 1.25;
      color: #ffffff;
      margin-bottom: 8px;
    }
    .hero-subtitle {
      font-size: 13px;
      line-height: 1.45;
      color: rgba(255, 255, 255, 0.88);
      margin-bottom: 16px;
    }
    .btn-play {
      display: block;
      background: #ffffff;
      color: #0056e0;
      font-size: 15px;
      font-weight: 900;
      text-align: center;
      padding: 13px;
      border-radius: 14px;
      text-decoration: none;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.2);
      transition: transform 0.15s;
    }
    .btn-play:active { transform: scale(0.98); }

    /* REALISTIC SPRIBE AVIATOR GAME CONTAINER */
    .aviator-game-wrapper {
      background: #0f121a;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 22px;
      padding: 12px;
      margin-bottom: 18px;
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.6);
      position: relative;
    }

    /* Game Header: Balance + Multiplier History Ribbon */
    .game-top-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 8px;
      padding: 2px 4px;
    }
    .game-bal-badge {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      font-weight: 800;
      color: #38bdf8;
      background: #171d2b;
      padding: 4px 10px;
      border-radius: 10px;
      border: 1px solid rgba(255, 255, 255, 0.06);
    }
    .game-provider-tag {
      font-size: 10px;
      font-weight: 900;
      color: #10b981;
      background: rgba(16, 185, 129, 0.12);
      border: 1px solid rgba(16, 185, 129, 0.3);
      padding: 3px 8px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      gap: 4px;
    }
    .green-dot {
      width: 6px;
      height: 6px;
      background: #10b981;
      border-radius: 50%;
      box-shadow: 0 0 6px #10b981;
    }

    /* History Ribbon (Past Crash Points) */
    .history-ribbon {
      display: flex;
      gap: 5px;
      overflow-x: auto;
      margin-bottom: 10px;
      padding: 2px 0 6px;
      scrollbar-width: none;
    }
    .history-ribbon::-webkit-scrollbar { display: none; }
    .history-pill {
      font-size: 11px;
      font-weight: 800;
      padding: 3px 8px;
      border-radius: 8px;
      white-space: nowrap;
      font-variant-numeric: tabular-nums;
    }
    .pill-blue { background: rgba(0, 122, 255, 0.2); color: #38bdf8; border: 1px solid rgba(0, 122, 255, 0.35); }
    .pill-purple { background: rgba(168, 85, 247, 0.2); color: #c084fc; border: 1px solid rgba(168, 85, 247, 0.35); }
    .pill-gold { background: rgba(245, 158, 11, 0.25); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.45); }

    /* Flight Arena Canvas */
    .flight-arena {
      background: #000000;
      border-radius: 16px;
      height: 250px;
      position: relative;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.08);
      margin-bottom: 12px;
    }
    #aviator-canvas {
      width: 100%;
      height: 100%;
      display: block;
    }

    /* Flight Overlay (Multiplier & Status) */
    .arena-overlay {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      text-align: center;
      pointer-events: none;
      z-index: 10;
    }
    .multiplier-val {
      font-size: 58px;
      font-weight: 900;
      color: #ffffff;
      letter-spacing: -1.5px;
      font-variant-numeric: tabular-nums;
      line-height: 1;
      text-shadow: 0 4px 20px rgba(0, 0, 0, 0.8);
    }
    .flew-away-text {
      font-size: 16px;
      font-weight: 900;
      color: #e11d48;
      text-transform: uppercase;
      letter-spacing: 2px;
      display: none;
      margin-top: 8px;
      text-shadow: 0 0 16px rgba(225, 29, 72, 0.8);
    }

    /* Countdown Bar across Arena */
    .waiting-bar-wrap {
      position: absolute;
      bottom: 20px;
      left: 30px;
      right: 30px;
      background: rgba(255, 255, 255, 0.08);
      height: 8px;
      border-radius: 4px;
      overflow: hidden;
      display: none;
    }
    .waiting-bar-fill {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, #e11d48 0%, #f43f5e 100%);
      transition: width 0.1s linear;
    }
    .waiting-label {
      position: absolute;
      bottom: 34px;
      left: 0;
      right: 0;
      text-align: center;
      font-size: 12px;
      font-weight: 800;
      color: #e2e8f0;
      letter-spacing: 0.5px;
      display: none;
    }

    /* Spribe Bet Console */
    .bet-console {
      background: #141822;
      border-radius: 16px;
      padding: 12px;
      border: 1px solid rgba(255, 255, 255, 0.06);
    }

    /* Mode Tabs: Bet / Auto */
    .tab-switch {
      display: flex;
      background: #090c12;
      border-radius: 10px;
      padding: 2px;
      margin-bottom: 10px;
      border: 1px solid rgba(255, 255, 255, 0.05);
    }
    .tab-btn {
      flex: 1;
      background: none;
      border: none;
      color: #94a3b8;
      font-size: 12px;
      font-weight: 800;
      padding: 6px 0;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.2s;
    }
    .tab-btn.active {
      background: #1e2638;
      color: #ffffff;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
    }

    /* Bet amount row */
    .bet-input-row {
      display: flex;
      gap: 10px;
      align-items: center;
      margin-bottom: 10px;
    }
    .stepper-box {
      flex: 1;
      display: flex;
      align-items: center;
      background: #090c12;
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      padding: 2px 4px;
    }
    .step-btn {
      background: none;
      border: none;
      color: #94a3b8;
      font-size: 20px;
      font-weight: 900;
      width: 34px;
      height: 34px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .bet-value-display {
      flex: 1;
      font-size: 14px;
      font-weight: 800;
      color: #ffffff;
      text-align: center;
      font-variant-numeric: tabular-nums;
    }

    /* Big Action Button (Spribe Style Green / Orange) */
    .btn-aviator-action {
      flex: 1.2;
      height: 48px;
      border: none;
      border-radius: 12px;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      font-family: inherit;
      transition: all 0.15s;
    }
    .btn-aviator-action.state-bet {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      box-shadow: 0 4px 16px rgba(16, 185, 129, 0.4);
      color: #ffffff;
    }
    .btn-aviator-action.state-cashout {
      background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
      box-shadow: 0 4px 20px rgba(245, 158, 11, 0.55);
      color: #ffffff;
      animation: pulse-glow 1.1s infinite;
    }
    .btn-aviator-action.state-waiting {
      background: #273043;
      color: #94a3b8;
      cursor: not-allowed;
    }
    .btn-title-main {
      font-size: 14px;
      font-weight: 900;
      letter-spacing: 0.5px;
    }
    .btn-sub-cash {
      font-size: 12px;
      font-weight: 700;
      color: #fef08a;
      font-variant-numeric: tabular-nums;
    }
    @keyframes pulse-glow {
      0% { transform: scale(1); }
      50% { transform: scale(1.02); }
      100% { transform: scale(1); }
    }

    /* Chips Presets */
    .chip-presets-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 6px;
      margin-bottom: 8px;
    }
    .bet-chip {
      background: #171d2b;
      color: #94a3b8;
      border: 1px solid rgba(255, 255, 255, 0.05);
      padding: 7px 0;
      border-radius: 8px;
      font-size: 11px;
      font-weight: 700;
      cursor: pointer;
      text-align: center;
      transition: all 0.15s;
    }
    .bet-chip.active {
      background: #007aff;
      color: #ffffff;
      border-color: #007aff;
      box-shadow: 0 2px 8px rgba(0, 122, 255, 0.35);
    }

    /* Auto Cashout Options */
    .auto-options-row {
      display: none;
      justify-content: space-between;
      align-items: center;
      padding-top: 8px;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      margin-top: 8px;
    }
    .auto-options-row.active { display: flex; }
    .auto-label {
      font-size: 11px;
      font-weight: 700;
      color: #94a3b8;
    }
    .auto-stepper {
      display: flex;
      align-items: center;
      background: #090c12;
      border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      padding: 2px 6px;
    }
    .auto-mult-val {
      font-size: 12px;
      font-weight: 800;
      color: #38bdf8;
      padding: 0 8px;
    }

    /* Win Banner */
    .win-congrats-banner {
      background: rgba(16, 185, 129, 0.15);
      border: 1px solid rgba(16, 185, 129, 0.35);
      border-radius: 12px;
      padding: 10px;
      text-align: center;
      margin-top: 10px;
      display: none;
    }

    /* PROBABILITY CALCULATOR (Seamlessly Integrated) */
    .calc-card {
      background: #141a24;
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 24px;
      padding: 18px 16px;
      margin-bottom: 16px;
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35);
    }
    .calc-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 14px;
    }
    .calc-title {
      font-size: 15px;
      font-weight: 800;
      color: #ffffff;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .calc-badge {
      font-size: 10px;
      font-weight: 800;
      color: #38bdf8;
      background: rgba(56, 189, 248, 0.12);
      border: 1px solid rgba(56, 189, 248, 0.25);
      padding: 3px 8px;
      border-radius: 8px;
      letter-spacing: 0.5px;
    }
    .calc-metrics-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      padding-bottom: 12px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      margin-bottom: 14px;
    }
    .metric-label {
      font-size: 11px;
      font-weight: 700;
      color: #94a3b8;
      text-transform: uppercase;
      margin-bottom: 4px;
    }
    .metric-val-coeff {
      font-size: 32px;
      font-weight: 900;
      color: #ffffff;
      font-variant-numeric: tabular-nums;
    }
    .metric-val-prob {
      font-size: 32px;
      font-weight: 900;
      color: #38bdf8;
      font-variant-numeric: tabular-nums;
    }
    .slider-wrap {
      margin-bottom: 14px;
    }
    .calc-slider {
      width: 100%;
      height: 6px;
      border-radius: 3px;
      background: #171d28;
      outline: none;
      -webkit-appearance: none;
    }
    .calc-slider::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: #ffffff;
      cursor: pointer;
      box-shadow: 0 0 12px rgba(0, 122, 255, 0.8);
      border: 3px solid #007aff;
    }
    .preset-chips {
      display: flex;
      gap: 6px;
      margin-bottom: 14px;
    }
    .btn-preset {
      flex: 1;
      background: #171d28;
      color: #94a3b8;
      border: 1px solid rgba(255, 255, 255, 0.06);
      padding: 7px 0;
      border-radius: 10px;
      font-size: 12px;
      font-weight: 800;
      cursor: pointer;
      transition: all 0.15s;
    }
    .btn-preset.active {
      background: #007aff;
      color: #ffffff;
      border-color: #007aff;
      box-shadow: 0 2px 8px rgba(0, 122, 255, 0.35);
    }
    .calc-disclaimer {
      font-size: 11px;
      color: #94a3b8;
      line-height: 1.45;
      background: rgba(255, 255, 255, 0.03);
      padding: 10px 12px;
      border-radius: 12px;
      border-left: 3px solid #f59e0b;
    }

    /* Second Card (Links & Guides) */
    .second-card {
      background: #141a24;
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 24px;
      padding: 18px 16px;
      margin-bottom: 16px;
    }
    .second-title {
      font-size: 15px;
      font-weight: 800;
      color: #ffffff;
      margin-bottom: 4px;
    }
    .second-subtitle {
      font-size: 12px;
      color: #7b8e9f;
      line-height: 1.45;
      margin-bottom: 14px;
    }
    .card-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 11px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    }
    .card-row:last-child { border-bottom: none; }
    .btn-action-small {
      background: #007aff;
      color: #ffffff;
      font-size: 12px;
      font-weight: 800;
      padding: 7px 14px;
      border-radius: 10px;
      text-decoration: none;
      white-space: nowrap;
    }

    /* 3 Step Cards */
    .step-item {
      display: flex;
      gap: 12px;
      align-items: center;
      padding: 10px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    }
    .step-item:last-child { border-bottom: none; }
    .step-num {
