        </div>
      </details>

      <details class="faq-item">
        <summary class="faq-question">Aviator APK ilovasini qayerdan xavfsiz yuklab olish mumkin?</summary>
        <div class="faq-answer">
          Saytimizdagi «APK Ilova» bo'limiga o'tib, rasmiy Android ilovasini xavfsiz va blokirovkasiz to'g'ridan-to'g'ri yuklab olishingiz mumkin.
        </div>
      </details>
    </div>

    <!-- Футер -->
    <footer>
      <div style="margin-bottom: 8px;">
        <a href="/masuliyatli-oyin">Mas'uliyatli o'yin (18+)</a>
        <a href="/maxfiylik-siyosati">Maxfiylik siyosati</a>
      </div>
      © 2026 Aviator Uzbek. 18+ Mas'uliyat bilan o'ynang.
    </footer>
  </div>

  <!-- Нижнее меню навигации -->
  <nav class="bottom-bar">
    <a href="/" class="bottom-item active">
      <span class="bottom-icon">🏠</span>
      <span>Asosiy</span>
    </a>
    <a href={refLink} target="_blank" rel="nofollow sponsored" class="bottom-item">
      <span class="bottom-icon">✈️</span>
      <span>Aviator</span>
    </a>
    <a href="/ilova" class="bottom-item">
      <span class="bottom-icon">📲</span>
      <span>APK</span>
    </a>
    <a href="/uzcard-depozit" class="bottom-item">
      <span class="bottom-icon">💳</span>
      <span>To'lov</span>
    </a>
    <a href={refLink} target="_blank" rel="nofollow sponsored" class="bottom-item">
      <span class="bottom-icon">🎁</span>
      <span>Bonus</span>
    </a>
  </nav>

  <!-- ЛОГИКА СИМУЛЯТОРА -->
  <script>
    let currentBet = 10000;
    let isRunning = false;
    let multiplier = 1.0;
    let interval = null;
    let crashPoint = 2.0;

    const multEl = document.getElementById('sim-mult');
    const statusEl = document.getElementById('sim-status');
    const planeEl = document.getElementById('sim-plane');
    const btnEl = document.getElementById('sim-btn');
    const resultBox = document.getElementById('sim-result');
    const resultText = document.getElementById('sim-result-text');
    const chipBtns = document.querySelectorAll('.sim-chip-btn');

    chipBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        if (isRunning) return;
        chipBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentBet = parseInt(btn.dataset.bet || '10000', 10);
      });
    });

    btnEl?.addEventListener('click', () => {
      if (!isRunning) {
        // Старт раунда
        isRunning = true;
        multiplier = 1.0;
        resultBox.style.display = 'none';
        btnEl.classList.add('cashing');
        btnEl.textContent = "💰 Yutuqni Olish (Kassa)";
        statusEl.textContent = "Samolyot parvozda...";
        statusEl.style.color = "#34d399";
        
        // Генерация случайного коэффициента краша от 1.3 до 5.5
        crashPoint = (Math.random() * 4.2 + 1.3);

        const startTime = Date.now();
        interval = setInterval(() => {
          multiplier += 0.02 * (multiplier * 0.4);
          multEl.textContent = multiplier.toFixed(2) + 'x';

          // Движение самолетика
          const progress = Math.min((multiplier - 1) / 3, 1);
          planeEl.style.bottom = (20 + progress * 70) + 'px';
          planeEl.style.left = (20 + progress * 240) + 'px';

          if (multiplier >= crashPoint) {
            // Краш (самолет улетел)
            clearInterval(interval);
            isRunning = false;
            btnEl.classList.remove('cashing');
            btnEl.textContent = "🔄 Qayta Sinab Ko'rish";
            statusEl.textContent = "Uchib ketdi!";
            statusEl.style.color = "#ef4444";
            multEl.style.color = "#ef4444";
            planeEl.style.transform = "rotate(-25deg) translateY(-80px)";
            planeEl.style.opacity = "0";

            setTimeout(() => {
              planeEl.style.transform = "none";
              planeEl.style.opacity = "1";
              planeEl.style.bottom = "20px";
              planeEl.style.left = "20px";
              multEl.style.color = "#ffffff";
            }, 1000);
          }
        }, 50);

      } else {
        // Успешный кэшаут игрока
        clearInterval(interval);
        isRunning = false;
        btnEl.classList.remove('cashing');
        btnEl.textContent = "🚀 Yana O'ynash";
        statusEl.textContent = "Yutuq yechildi!";
        statusEl.style.color = "#10b981";

        const wonAmount = Math.round(currentBet * multiplier).toLocaleString('uz-UZ');
        resultText.innerHTML = `Tabriklaymiz! Siz <b>${wonAmount} so'm</b> yutdingiz! 🎉`;
        resultBox.style.display = 'block';
      }
    });
  </script>

</body>
</html>
