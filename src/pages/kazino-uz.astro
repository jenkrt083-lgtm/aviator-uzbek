      text-decoration: none;
      border: 1px solid rgba(255, 255, 255, 0.05);
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }
    .chip.active {
      background: #007aff;
      color: #ffffff;
      border-color: #007aff;
      box-shadow: 0 4px 12px rgba(0, 122, 255, 0.35);
    }

    /* Hero Header */
