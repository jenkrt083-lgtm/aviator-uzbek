      background: linear-gradient(145deg, #0738b8 0%, #0056e0 50%, #007aff 100%);
      border-radius: 24px;
      padding: 22px 18px 20px;
      position: relative;
      overflow: hidden;
      margin-bottom: 16px;
      box-shadow: 0 12px 28px rgba(0, 122, 255, 0.28);
    }
    .hero-strat-box::after {
      content: '🏬';
      position: absolute;
      right: -8px;
      top: 10px;
      font-size: 84px;
      opacity: 0.16;
      pointer-events: none;
    }
    .hero-badge {
