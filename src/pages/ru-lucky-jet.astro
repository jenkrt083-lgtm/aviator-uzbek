  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
    body { background-color: #0b0e14; color: #f1f5f9; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; min-height: 100vh; padding-bottom: 120px; }
    .app-wrapper { max-width: 460px; margin: 0 auto; padding: 14px 14px 20px; }
    .lang-bar { display: flex; justify-content: flex-end; gap: 6px; margin-bottom: 12px; }
    .lang-btn { font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 8px; text-decoration: none; color: #94a3b8; background: #171d28; border: 1px solid rgba(255,255,255,.05); }
    .lang-btn.active { background: #7c3aed; color: #fff; border-color: #7c3aed; }
    .top-chips { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 14px; scrollbar-width: none; }
    .top-chips::-webkit-scrollbar { display: none; }
    .chip { background: #171d28; color: #94a3b8; font-size: 13px; font-weight: 700; padding: 8px 16px; border-radius: 20px; white-space: nowrap; text-decoration: none; border: 1px solid rgba(255,255,255,.05); }
    .chip.active-purple { background: #7c3aed; color: #fff; border-color: #8b5cf6; }
    .hero-card { background: linear-gradient(145deg,#4c1d95 0%,#6d28d9 50%,#7c3aed 100%); border-radius: 24px; padding: 22px 18px 20px; position: relative; overflow: hidden; margin-bottom: 14px; }
    .hero-tag { display: inline-block; background: rgba(255,255,255,.2); color: #fff; font-size: 11px; font-weight: 800; padding: 4px 10px; border-radius: 12px; text-transform: uppercase; margin-bottom: 12px; }
    .hero-title { font-size: 22px; font-weight: 900; line-height: 1.25; color: #fff; margin-bottom: 8px; }
    .hero-subtitle { font-size: 13px; color: rgba(255,255,255,.88); line-height: 1.45; margin-bottom: 18px; max-width: 85%; }
    .btn-play-lj { background: #fff; color: #4c1d95; font-weight: 800; font-size: 16px; text-align: center; padding: 15px; border-radius: 16px; display: block; text-decoration: none; }
    .second-card { background: #111722; border: 1px solid #1c2637; border-radius: 18px; padding: 16px; margin-bottom: 12px; }
    .second-title { font-size: 15px; font-weight: 800; color: #fff; margin-bottom: 4px; }
    .second-subtitle { font-size: 12px; color: #94a3b8; line-height: 1.5; }
    .faq-section { margin-bottom: 20px; }
    .faq-header { font-size: 17px; font-weight: 800; color: #fff; margin-bottom: 12px; }
    .faq-item { background: #111722; border: 1px solid #1c2637; border-radius: 16px; margin-bottom: 8px; overflow: hidden; }
    .faq-question { padding: 14px 16px; font-size: 13px; font-weight: 700; color: #f1f5f9; cursor: pointer; list-style: none; }
    .faq-answer { padding: 0 16px 14px; font-size: 12px; color: #94a3b8; line-height: 1.55; }
    footer { text-align: center; font-size: 11px; color: #4f5f73; padding: 16px 0 20px; }
    footer a { color: #64748b; margin: 0 6px; }
  </style>
</head>
<body>
  <div class="app-wrapper">
