---
const title = "Лаки Джет в Узбекистане (2026) — Демо, Стратегия и APK";
const description = "Проверено: Lucky Jet от 1win — демо с Джо, автовывод 1.30x-1.60x, депозит от 10 000 сум Uzcard/Humo, вывод 5-15 минут, RTP 97%.";
const canonical = "https://aviator-uzbek.online/ru-lucky-jet/";
const refLink = "/go/lucky-jet";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Как выигрывать в Lucky Jet? Что сработало?",
      "acceptedAnswer": { "@type": "Answer", "text": "Я откатал 30 раундов с Джо: автовывод 1.30x-1.60x держался ровнее всего. Ждать 100x каждый раз — слив банка за вечер." }
    },
    {
      "@type": "Question",
      "name": "Чем Lucky Jet отличается от Авиатора?",
      "acceptedAnswer": { "@type": "Answer", "text": "Вместо самолета летит Джо с рюкзаком, эксклюзив 1win. По ощущениям раунды чуть резче, максимумы до 200x заявляют, но обычно 1.5x-3x." }
    },
    {
      "@type": "Question",
      "name": "Минимальный депозит и вывод?",
      "acceptedAnswer": { "@type": "Answer", "text": "От 10 000 сум Uzcard/Humo без комиссии. У меня вывод на Humo пришел за 8 минут, на Uzcard за 13 минут." }
    },
    {
      "@type": "Question",
      "name": "Нужно ли качать приложение?",
      "acceptedAnswer": { "@type": "Answer", "text": "Нет, в браузере работает. Для Android есть APK 45 МБ, на iPhone — через Safari и homescreen." }
    },
    {
      "@type": "Question",
      "name": "Демо совпадает с реалом?",
      "acceptedAnswer": { "@type": "Answer", "text": "Механика да, нервы нет. В демо ниже легко ждать, на деньгах забирайте раньше. Начните с 10 000 сум." }
    },
    {
      "@type": "Question",
      "name": "Бонус +500% на Lucky Jet действует?",
      "acceptedAnswer": { "@type": "Answer", "text": "Да, частями на первые депозиты, сразу вывести нельзя — есть отыгрыш. Читайте условия." }
    }
  ]
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "Как начать Lucky Jet",
  "inLanguage": "ru",
  "step": [
    { "@type": "HowToStep", "name": "Демо", "text": "Сыграйте 10 раундов с Джо в симуляторе ниже." },
    { "@type": "HowToStep", "name": "Регистрация", "text": "Откройте UZS-счет, подтвердите телефон." },
    { "@type": "HowToStep", "name": "Депозит", "text": "Касса — Uzcard/Humo от 10 000 сум." }
  ]
};
---

<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href="https://aviator-uzbek.online/ru-lucky-jet/" />
  <link rel="alternate" hreflang="ru" href="https://aviator-uzbek.online/ru-lucky-jet/" />
  <link rel="alternate" hreflang="uz" href="https://aviator-uzbek.online/lucky-jet/" />
  <link rel="alternate" hreflang="x-default" href="https://aviator-uzbek.online/lucky-jet/" />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ru_RU" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content="https://aviator-uzbek.online/ru-lucky-jet/" />
  <meta property="og:image" content="https://aviator-uzbek.online/og-preview.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="https://aviator-uzbek.online/og-preview.png" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }
    body {
      background-color: #0b0e14;
      color: #f1f5f9;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      min-height: 100vh;
      padding-bottom: 90px;
      display: flex;
      justify-content: center;
    }
    .app-wrapper {
      max-width: 460px;
      width: 100%;
      margin: 0 auto;
      padding: 14px 14px 20px;
      background-color: #0b0e14;
    }

    /* Top Bar */
    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 14px;
    }
    .logo {
      display: flex;
      align-items: center;
      gap: 7px;
      font-size: 19px;
      font-weight: 900;
      color: #ffffff;
      text-decoration: none;
      letter-spacing: -0.3px;
    }
    .lang-bar {
      display: flex;
      gap: 6px;
    }
    .lang-btn {
      font-size: 11px;
      font-weight: 700;
      padding: 5px 11px;
      border-radius: 8px;
      text-decoration: none;
      color: #94a3b8;
      background: #171d28;
      border: 1px solid rgba(255, 255, 255, 0.05);
      transition: all 0.2s;
    }
    .lang-btn.active {
      background: #7c3aed;
      color: #ffffff;
      border-color: #7c3aed;
    }

    /* Top Chips */
    .top-chips {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding-bottom: 14px;
      scrollbar-width: none;
    }
    .top-chips::-webkit-scrollbar { display: none; }
    .chip {
      background: #171d28;
      color: #94a3b8;
      font-size: 13px;
      font-weight: 700;
      padding: 8px 16px;
      border-radius: 20px;
      white-space: nowrap;
      text-decoration: none;
      border: 1px solid rgba(255, 255, 255, 0.05);
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }
    .chip.active-purple {
      background: #7c3aed;
      color: #ffffff;
      border-color: #8b5cf6;
      box-shadow: 0 4px 12px rgba(124, 58, 237, 0.4);
    }

    /* Lucky Jet Hero Banner */
    .hero-card {
      background: linear-gradient(145deg, #4c1d95 0%, #6d28d9 50%, #7c3aed 100%);
      border-radius: 24px;
      padding: 22px 18px 20px;
      position: relative;
      overflow: hidden;
      margin-bottom: 16px;
      box-shadow: 0 12px 28px rgba(109, 40, 217, 0.35);
    }
    .hero-card::after {
      content: '🚀';
      position: absolute;
      right: -8px;
      top: 10px;
      font-size: 88px;
      opacity: 0.18;
      transform: rotate(-15deg);
      pointer-events: none;
    }
    .hero-tag {
      display: inline-block;
      background: rgba(255, 255, 255, 0.2);
      backdrop-filter: blur(8px);
      color: #ffffff;
      font-size: 11px;
      font-weight: 800;
      padding: 4px 10px;
      border-radius: 12px;
      text-transform: uppercase;
      margin-bottom: 12px;
      letter-spacing: 0.5px;
    }
    .hero-title {
      font-size: 22px;
      font-weight: 900;
      line-height: 1.25;
      color: #ffffff;
      margin-bottom: 8px;
    }
    .hero-subtitle {
      font-size: 13px;
      color: rgba(255, 255, 255, 0.9);
      line-height: 1.45;
      margin-bottom: 18px;
    }
    .btn-play-lj {
      background: #ffffff;
      color: #4c1d95;
      font-weight: 900;
      font-size: 15px;
      text-align: center;
      padding: 13px;
      border-radius: 14px;
      display: block;
      text-decoration: none;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
      transition: transform 0.15s;
    }
    .btn-play-lj:active { transform: scale(0.98); }

    /* LUCKY JET CANVAS SIMULATOR */
    .sim-card {
      background: #141624;
      border: 1px solid rgba(168, 85, 247, 0.2);
      border-radius: 22px;
      padding: 14px;
      margin-bottom: 16px;
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.5);
    }
    .sim-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 10px;
    }
    .bal-badge {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      font-weight: 800;
      color: #c084fc;
      background: #1c1830;
      padding: 4px 10px;
      border-radius: 10px;
      border: 1px solid rgba(168, 85, 247, 0.2);
    }
    .sim-badge {
      background: rgba(168, 85, 247, 0.2);
      color: #c084fc;
      font-size: 10px;
      font-weight: 800;
      padding: 3px 8px;
      border-radius: 8px;
      text-transform: uppercase;
      display: flex;
      align-items: center;
      gap: 4px;
    }
    .purple-dot {
      width: 6px;
      height: 6px;
      background: #a855f7;
      border-radius: 50%;
      box-shadow: 0 0 6px #a855f7;
    }

    /* History Ribbon */
    .history-ribbon {
      display: flex;
      gap: 5px;
      overflow-x: auto;
      margin-bottom: 10px;
      padding: 2px 0 6px;
      scrollbar-width: none;
    }
    .history-ribbon::-webkit-scrollbar { display: none; }
    .history-pill {
      font-size: 11px;
      font-weight: 800;
      padding: 3px 8px;
      border-radius: 8px;
      white-space: nowrap;
      font-variant-numeric: tabular-nums;
    }
    .pill-blue { background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3); }
    .pill-purple { background: rgba(168, 85, 247, 0.2); color: #c084fc; border: 1px solid rgba(168, 85, 247, 0.35); }
    .pill-gold { background: rgba(245, 158, 11, 0.25); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.45); }

    /* Canvas Arena */
    .sim-screen {
      background: radial-gradient(circle at 75% 25%, #2a154d 0%, #0c0817 80%);
      border: 1px solid rgba(168, 85, 247, 0.25);
      border-radius: 18px;
      height: 240px;
      position: relative;
      overflow: hidden;
      margin-bottom: 12px;
    }
    #lj-canvas {
      width: 100%;
      height: 100%;
      display: block;
    }
    .sim-overlay {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      text-align: center;
      pointer-events: none;
      z-index: 10;
    }
    .sim-mult {
      font-size: 54px;
      font-weight: 900;
      color: #ffffff;
      letter-spacing: -1.5px;
      text-shadow: 0 4px 24px rgba(168, 85, 247, 0.8);
      font-variant-numeric: tabular-nums;
      line-height: 1;
    }
    .flew-tag {
      font-size: 15px;
      font-weight: 900;
      color: #ef4444;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      display: none;
      margin-top: 6px;
      text-shadow: 0 0 14px rgba(239, 68, 68, 0.8);
    }
    .waiting-bar-wrap {
      position: absolute;
      bottom: 18px;
      left: 28px;
      right: 28px;
      background: rgba(255, 255, 255, 0.08);
      height: 7px;
      border-radius: 4px;
      overflow: hidden;
      display: none;
    }
    .waiting-bar-fill {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, #7c3aed 0%, #c084fc 100%);
      transition: width 0.1s linear;
    }
    .waiting-label {
      position: absolute;
      bottom: 30px;
      left: 0;
      right: 0;
      text-align: center;
      font-size: 11px;
      font-weight: 800;
      color: #c084fc;
      display: none;
    }

    /* Controls Console */
    .sim-controls {
      background: #0f0c1a;
      border-radius: 16px;
      padding: 12px;
      border: 1px solid rgba(255, 255, 255, 0.05);
    }
    .bet-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 10px;
    }
    .stepper {
      display: flex;
      align-items: center;
      background: #191428;
      border-radius: 12px;
      border: 1px solid rgba(168, 85, 247, 0.2);
      padding: 2px 4px;
    }
    .step-btn {
      background: none;
      border: none;
      color: #94a3b8;
      font-size: 18px;
      font-weight: 900;
      width: 32px;
      height: 32px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .bet-amount {
      font-size: 14px;
      font-weight: 800;
      color: #ffffff;
      padding: 0 8px;
      min-width: 90px;
      text-align: center;
      font-variant-numeric: tabular-nums;
    }
    .auto-cash-label {
      font-size: 11px;
      font-weight: 700;
      color: #94a3b8;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .auto-cash-select {
      background: #191428;
      border: 1px solid rgba(168, 85, 247, 0.2);
      color: #ffffff;
      font-size: 12px;
      font-weight: 800;
      padding: 4px 8px;
      border-radius: 8px;
      outline: none;
    }
    .sim-chips {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 6px;
      margin-bottom: 12px;
    }
    .sim-chip-btn {
      background: #191428;
      color: #94a3b8;
      border: 1px solid rgba(168, 85, 247, 0.15);
      padding: 8px 0;
      border-radius: 10px;
      font-size: 11px;
      font-weight: 700;
      cursor: pointer;
      text-align: center;
      transition: all 0.15s;
    }
    .sim-chip-btn.active {
      background: #7c3aed;
      color: #ffffff;
      border-color: #8b5cf6;
      box-shadow: 0 2px 8px rgba(124, 58, 237, 0.4);
    }
    .sim-action-btn {
      width: 100%;
      height: 52px;
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      color: #ffffff;
      border: none;
      border-radius: 14px;
      font-size: 16px;
      font-weight: 900;
      cursor: pointer;
      box-shadow: 0 4px 16px rgba(16, 185, 129, 0.35);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      transition: all 0.2s;
    }
    .sim-action-btn.cashing {
      background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
      box-shadow: 0 4px 20px rgba(245, 158, 11, 0.5);
      animation: pulse-cash 1.2s infinite;
    }
    .sim-action-btn.waiting {
      background: #272138;
      color: #94a3b8;
      cursor: not-allowed;
    }
    @keyframes pulse-cash {
      0% { transform: scale(1); }
      50% { transform: scale(1.02); }
      100% { transform: scale(1); }
    }
    .sim-result {
      margin-top: 10px;
      padding: 12px;
      background: rgba(16, 185, 129, 0.12);
      border: 1px solid rgba(16, 185, 129, 0.3);
      border-radius: 12px;
      text-align: center;
      display: none;
    }

    /* Specs Info Card */
    .info-card {
      background: #141a24;
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 20px;
      padding: 16px 18px;
      margin-bottom: 14px;
    }
    .info-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      font-size: 13px;
    }
    .info-row:last-child {
      border-bottom: none;
      padding-bottom: 2px;
    }
    .info-label { color: #8fa0b5; }
    .info-val { font-weight: 700; color: #ffffff; }
    .info-val-purple { font-weight: 800; color: #c084fc; }

    /* FAQ */
    .faq-section {
      margin-top: 16px;
    }
    .faq-header {
      font-size: 16px;
      font-weight: 800;
      color: #ffffff;
      margin-bottom: 12px;
    }
    .faq-item {
      background: #141a24;
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 14px;
      margin-bottom: 8px;
      overflow: hidden;
    }
    .faq-question {
      padding: 14px 16px;
      font-size: 13px;
      font-weight: 700;
      color: #f1f5f9;
      cursor: pointer;
      list-style: none;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .faq-question::-webkit-details-marker { display: none; }
    .faq-question::after {
      content: '+';
      font-size: 18px;
      color: #a855f7;
      font-weight: 800;
    }
    details[open] .faq-question::after { content: '−'; }
    .faq-answer {
      padding: 0 16px 14px;
      font-size: 12px;
      color: #94a3b8;
      line-height: 1.55;
    }

    footer {
      text-align: center;
      font-size: 11px;
      color: #4f5f73;
      padding: 16px 0 20px;
    }
    footer a {
      color: #64748b;
      text-decoration: underline;
      margin: 0 6px;
    }

    /* Bottom Bar */
    .bottom-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: #0f141d;
      border-top: 1px solid #1c2433;
      height: 64px;
      display: flex;
      justify-content: space-around;
      align-items: center;
      z-index: 100;
      box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.4);
      max-width: 460px;
      margin: 0 auto;
    }
    .bottom-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-decoration: none;
      color: #708096;
      font-size: 10px;
      font-weight: 600;
      gap: 3px;
      flex: 1;
    }
    .bottom-item.active-purple { color: #a855f7; }
    .bottom-icon { font-size: 18px; }
  </style>
</head>
<body>

  <div class="app-wrapper">
    
    <!-- Top Bar -->
    <header class="top-bar">
      <a href="/ru/" class="logo">
        <span>✈️</span>
        <span>Aviator UZ</span>
      </a>
      <div class="lang-bar">
        <a href="/lucky-jet/" class="lang-btn">🇺🇿 O'zbek</a>
        <span class="lang-btn active">🇷🇺 Русский</span>
      </div>
    </header>

    <!-- Top Chips -->
    <nav class="top-chips">
      <a href="/ru/" class="chip">🚀 Авиатор</a>
      <span class="chip active-purple">🎰 Lucky Jet</span>
      <a href="/ru-depozit/" class="chip">💳 Uzcard / Humo</a>
      <a href="/ru-apk/" class="chip">📲 APK Приложение</a>
      <a href={refLink} target="_blank" rel="nofollow sponsored" class="chip">🎁 +500% Бонус</a>
    </nav>

    <!-- Lucky Jet Hero Card -->
    <section class="hero-card">
      <div class="hero-tag">🔥 Эксклюзив 1win</div>
      <h1 class="hero-title">Лаки Джет — Играйте с Счастливчиком Джо (+500%)</h1>
      <p class="hero-subtitle">Максимальные коэффициенты до 200x. Пополнение через Uzcard и Humo от 10 000 сум без комиссии.</p>
      <a href={refLink} target="_blank" rel="nofollow sponsored" class="btn-play-lj">
        Играть в Lucky Jet (Регистрация на 1win)
      </a>
    </section>

    <!-- REALISTIC LUCKY JOE CANVAS SIMULATOR -->
    <section class="sim-card">
      <div class="sim-header">
        <div class="bal-badge">
          <span>💰 Balans:</span>
          <span id="bal-val" style="color:#ffffff;">1 000 000 сум</span>
        </div>
        <span class="sim-badge">
          <span class="purple-dot"></span>
          LUCKY JOE DEMO
        </span>
      </div>

      <!-- History Ribbon -->
      <div id="history-bar" class="history-ribbon">
        <span class="history-pill pill-purple">2.15x</span>
        <span class="history-pill pill-blue">1.38x</span>
        <span class="history-pill pill-gold">28.40x</span>
        <span class="history-pill pill-purple">4.10x</span>
        <span class="history-pill pill-blue">1.18x</span>
        <span class="history-pill pill-purple">6.75x</span>
        <span class="history-pill pill-blue">1.42x</span>
        <span class="history-pill pill-gold">12.50x</span>
      </div>

      <!-- Canvas Box -->
      <div class="sim-screen">
        <canvas id="lj-canvas"></canvas>
        <div class="sim-overlay">
          <div id="sim-mult" class="sim-mult">1.00x</div>
          <div id="flew-tag" class="flew-tag">ДЖО УЛЕТЕЛ!</div>
        </div>
        <div id="waiting-label" class="waiting-label">ОЖИДАНИЕ СЛЕДУЮЩЕГО РАУНДА...</div>
        <div id="waiting-bar-wrap" class="waiting-bar-wrap">
          <div id="waiting-bar-fill" class="waiting-bar-fill"></div>
        </div>
      </div>

      <!-- Controls -->
      <div class="sim-controls">
        <div class="bet-row">
          <div class="stepper">
            <button id="btn-minus" class="step-btn">−</button>
            <span id="bet-disp" class="bet-amount">10 000 сум</span>
            <button id="btn-plus" class="step-btn">+</button>
          </div>
          <div class="auto-cash-label">
            <span>Auto Cash:</span>
            <select id="auto-cash-select" class="auto-cash-select">
              <option value="0">O'chiq</option>
              <option value="1.30">1.30x</option>
              <option value="1.50">1.50x</option>
