---
const title = "Лаки Джет в Узбекистане (2026) — демо, стратегия Джо, APK и Uzcard";
const description = "Проверено: Lucky Jet от 1win — демо с Джо, автовывод 1.30x-1.60x, депозит от 10 000 сум Uzcard/Humo, вывод 5-15 минут, RTP 97%.";
const canonical = "https://aviator-uzbek.online/ru-lucky-jet";
const refLink = "/go/lucky-jet";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Как выигрывать в Lucky Jet? Что сработало?",
      "acceptedAnswer": { "@type": "Answer", "text": "Я откатал 30 раундов с Джо: автовывод 1.30x-1.60x держался ровнее всего. Ждать 100x каждый раз — слив банка за вечер." }
    },
    {
      "@type": "Question",
      "name": "Чем Lucky Jet отличается от Авиатора?",
      "acceptedAnswer": { "@type": "Answer", "text": "Вместо самолета летит Джо с рюкзаком, эксклюзив 1win. По ощущениям раунды чуть резче, максимумы до 200x заявляют, но обычно 1.5x-3x." }
    },
    {
      "@type": "Question",
      "name": "Минимальный депозит и вывод?",
      "acceptedAnswer": { "@type": "Answer", "text": "От 10 000 сум Uzcard/Humo без комиссии. У меня вывод на Humo пришел за 8 минут, на Uzcard за 13 минут." }
    },
    {
      "@type": "Question",
      "name": "Нужно ли качать приложение?",
      "acceptedAnswer": { "@type": "Answer", "text": "Нет, в браузере работает. Для Android есть APK 45 МБ, на iPhone — через Safari и homescreen." }
    },
    {
      "@type": "Question",
      "name": "Демо совпадает с реалом?",
      "acceptedAnswer": { "@type": "Answer", "text": "Механика да, нервы нет. В демо ниже легко ждать, на деньгах забирайте раньше. Начните с 10 000 сум." }
    },
    {
      "@type": "Question",
      "name": "Бонус +500% на Lucky Jet действует?",
      "acceptedAnswer": { "@type": "Answer", "text": "Да, частями на первые депозиты, сразу вывести нельзя — есть отыгрыш. Читайте условия." }
    }
  ]
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "Как начать Lucky Jet",
  "inLanguage": "ru",
  "step": [
    { "@type": "HowToStep", "name": "Демо", "text": "Сыграйте 10 раундов с Джо в симуляторе ниже." },
    { "@type": "HowToStep", "name": "Регистрация", "text": "Откройте UZS-счет, подтвердите телефон." },
    { "@type": "HowToStep", "name": "Депозит", "text": "Касса — Uzcard/Humo от 10 000 сум." }
  ]
};
---

<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="ru" href="https://aviator-uzbek.online/ru-lucky-jet" />
  <link rel="alternate" hreflang="uz" href="https://aviator-uzbek.online/lucky-jet" />
  <link rel="alternate" hreflang="x-default" href="https://aviator-uzbek.online/lucky-jet" />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ru_RU" />
  <meta property="og:locale:alternate" content="uz_UZ" />
