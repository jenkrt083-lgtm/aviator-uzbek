  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }
    body {
      background-color: #0b0e14;
      color: #f1f5f9;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      min-height: 100vh;
      padding-bottom: 90px;
      display: flex;
      justify-content: center;
    }
    .app-wrapper {
      max-width: 460px;
      width: 100%;
      margin: 0 auto;
      padding: 14px 14px 130px;
      background-color: #0b0e14;
    }

    /* Top Bar */
    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 14px;
    }
    .logo {
      display: flex;
      align-items: center;
      gap: 7px;
      font-size: 19px;
      font-weight: 900;
      color: #ffffff;
      text-decoration: none;
      letter-spacing: -0.3px;
    }
    .lang-bar {
      display: flex;
      gap: 6px;
    }
    .lang-btn {
      font-size: 11px;
      font-weight: 700;
      padding: 5px 11px;
      border-radius: 8px;
      text-decoration: none;
      color: #94a3b8;
      background: #171d28;
      border: 1px solid rgba(255, 255, 255, 0.05);
      transition: all 0.2s;
    }
    .lang-btn.active {
      background: #007aff;
      color: #ffffff;
      border-color: #007aff;
    }

    /* Top Chips */
    .top-chips {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding-bottom: 14px;
      scrollbar-width: none;
    }
    .top-chips::-webkit-scrollbar { display: none; }
    .chip {
      background: #171d28;
      color: #94a3b8;
      font-size: 13px;
      font-weight: 700;
      padding: 8px 16px;
      border-radius: 20px;
      white-space: nowrap;
      text-decoration: none;
      border: 1px solid rgba(255, 255, 255, 0.05);
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }
    .chip.active {
      background: #007aff;
      color: #ffffff;
      border-color: #007aff;
      box-shadow: 0 4px 12px rgba(0, 122, 255, 0.35);
    }

    /* Hero Header */
    .hero-strat-box {
      background: linear-gradient(145deg, #9f1239 0%, #be123c 50%, #e11d48 100%);
      border-radius: 24px;
      padding: 22px 18px 20px;
      position: relative;
      overflow: hidden;
      margin-bottom: 16px;
      box-shadow: 0 12px 28px rgba(190, 18, 60, 0.28);
    }
    .hero-strat-box::after {
      content: '🎰';
      position: absolute;
      right: -8px;
      top: 10px;
      font-size: 84px;
      opacity: 0.16;
      pointer-events: none;
    }
    .hero-badge {
      display: inline-block;
      background: rgba(255, 255, 255, 0.18);
      backdrop-filter: blur(8px);
      color: #ffffff;
      font-size: 11px;
      font-weight: 800;
      padding: 4px 10px;
      border-radius: 12px;
      text-transform: uppercase;
      margin-bottom: 12px;
      letter-spacing: 0.5px;
    }
    .hero-title {
      font-size: 21px;
      font-weight: 900;
      line-height: 1.28;
      color: #ffffff;
      margin-bottom: 8px;
    }
    .hero-lead {
      font-size: 13px;
      line-height: 1.5;
      color: rgba(255, 255, 255, 0.9);
      margin-bottom: 14px;
    }

    /* Strategy Cards */
    .strat-card {
      background: #141a24;
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 20px;
      padding: 18px 16px;
      margin-bottom: 14px;
      box-shadow: 0 8px 22px rgba(0, 0, 0, 0.3);
    }
    .strat-card-header {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 10px;
    }
    .strat-num-badge {
      background: #007aff;
      color: #ffffff;
      font-size: 13px;
      font-weight: 900;
      width: 28px;
      height: 28px;
      border-radius: 9px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      box-shadow: 0 2px 8px rgba(0, 122, 255, 0.4);
    }
    .strat-card h2 {
      font-size: 15px;
      font-weight: 800;
      color: #ffffff;
    }
    .strat-card p {
      font-size: 13px;
      color: #cbd5e1;
      line-height: 1.55;
    }

    /* Comparison Table */
    .table-wrap {
      overflow-x: auto;
      margin-top: 14px;
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
    }
    th {
      background: #172133;
      color: #94a3b8;
      font-weight: 800;
      padding: 10px 12px;
      text-align: left;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    td {
      padding: 10px 12px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.04);
      color: #e2e8f0;
    }
    tr:last-child td { border-bottom: none; }
    .badge-win-rate {
      font-weight: 800;
      padding: 2px 6px;
      border-radius: 6px;
      display: inline-block;
    }
    .rate-green { background: rgba(16, 185, 129, 0.15); color: #10b981; }
    .rate-blue { background: rgba(56, 189, 248, 0.15); color: #38bdf8; }
    .rate-red { background: rgba(239, 68, 68, 0.15); color: #f87171; }

    /* CTA Button */
    .btn-strat-cta {
      display: block;
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      color: #ffffff;
      font-size: 15px;
      font-weight: 900;
      text-align: center;
      padding: 14px;
      border-radius: 14px;
      text-decoration: none;
      margin: 18px 0;
      box-shadow: 0 6px 20px rgba(16, 185, 129, 0.35);
      transition: transform 0.15s;
    }
    .btn-strat-cta:active { transform: scale(0.98); }

    /* FAQ Section */
    .faq-title {
      font-size: 16px;
      font-weight: 800;
      color: #ffffff;
      margin: 20px 0 10px;
    }
    .faq-item {
      background: #141a24;
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 14px;
      margin-bottom: 8px;
      overflow: hidden;
    }
    .faq-q {
      padding: 13px 15px;
      font-size: 13px;
      font-weight: 700;
      color: #f1f5f9;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      list-style: none;
    }
    .faq-q::-webkit-details-marker { display: none; }
    .faq-q::after {
      content: '+';
      font-size: 16px;
      color: #007aff;
      font-weight: 700;
    }
    details[open] .faq-q::after { content: '−'; }
    .faq-a {
      padding: 0 15px 13px;
      font-size: 12px;
      line-height: 1.5;
      color: #94a3b8;
    }

    /* Footer */
    footer {
      text-align: center;
      font-size: 11px;
      color: #475569;
      margin-top: 24px;
      padding: 16px 0 20px;
    }
    footer a {
      color: #64748b;
      text-decoration: underline;
      margin: 0 6px;
    }

    /* Bottom Bar */
    .bottom-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: #0f141d;
      border-top: 1px solid #1c2433;
      height: 64px;
      display: flex;
      justify-content: space-around;
      align-items: center;
      z-index: 100;
      box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.4);
      max-width: 460px;
      margin: 0 auto;
    }
    .bottom-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-decoration: none;
      color: #708096;
      font-size: 10px;
      font-weight: 600;
      gap: 3px;
      flex: 1;
    }
    .bottom-item.active { color: #007aff; }
    .bottom-icon { font-size: 18px; }
  </style>
</head>
<body>

  <div class="app-wrapper">

    <!-- Top Bar -->
    <header class="top-bar">
      <a href="/ru/" class="logo">
        <span>✈️</span>
        <span>Aviator UZ</span>
      </a>
      <div class="lang-bar">
        <a href="/pin-up-aviator/" class="lang-btn">🇺🇿 O'zbek</a>
        <span class="lang-btn active">🇷🇺 Русский</span>
