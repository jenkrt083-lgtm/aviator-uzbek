            <tr>
              <td><b>Aviator (Spribe)</b></td>
              <td><span class="badge-win-rate rate-green">официальный</span></td>
              <td><span class="badge-win-rate rate-green">официальный</span></td>
            </tr>
            <tr>
              <td><b>Мой депозит</b></td>
              <td>50 000 сум, Uzcard, 5 минут</td>
