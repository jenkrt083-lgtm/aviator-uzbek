<!-- Interactive Lucky Jet Script -->
  <script>
    const canvas = document.getElementById('lj-canvas');
    const ctx = canvas.getContext('2d');
    const multDisp = document.getElementById('sim-mult');
    const flewTag = document.getElementById('flew-tag');
    const waitingLabel = document.getElementById('waiting-label');
    const waitingBarWrap = document.getElementById('waiting-bar-wrap');
    const waitingBarFill = document.getElementById('waiting-bar-fill');
    const actionBtn = document.getElementById('btn-action');
    const winBox = document.getElementById('sim-win-box');
    const winText = document.getElementById('win-text');
    const balDisplay = document.getElementById('bal-val');
    const autoCashSelect = document.getElementById('auto-cash-select');
    const historyBar = document.getElementById('history-bar');

    let virtualBal = 1000000;
    let currentBet = 10000;
    let gameState = 'IDLE'; // IDLE, WAITING, FLYING, CRASHED, WON
    let currentMult = 1.00;
    let crashTarget = 2.00;
    let animId = null;
    let startTime = 0;

    function initCanvas() {
      const rect = canvas.getBoundingClientRect();
      canvas.width = rect.width * window.devicePixelRatio;
      canvas.height = rect.height * window.devicePixelRatio;
      ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
    }
    window.addEventListener('resize', initCanvas);
    initCanvas();

    // Draw Lucky Joe with Jetpack on Canvas
    function drawLuckyJoe(x, y, angle, isFlying) {
      ctx.save();
      ctx.translate(x, y);
      ctx.rotate(angle);

      // Jetpack flame
      if (isFlying) {
        const flameLen = 18 + Math.random() * 8;
        ctx.fillStyle = '#f59e0b';
        ctx.beginPath();
        ctx.moveTo(-10, 4);
        ctx.lineTo(-10 - flameLen, 8);
        ctx.lineTo(-10, 12);
        ctx.closePath();
        ctx.fill();

        ctx.fillStyle = '#38bdf8';
        ctx.beginPath();
        ctx.moveTo(-10, 6);
        ctx.lineTo(-10 - flameLen * 0.6, 8);
        ctx.lineTo(-10, 10);
        ctx.closePath();
        ctx.fill();
      }

      // Jetpack cylinder
      ctx.fillStyle = '#475569';
      ctx.beginPath();
      ctx.roundRect(-12, -4, 8, 18, 4);
      ctx.fill();
      ctx.strokeStyle = '#94a3b8';
      ctx.lineWidth = 1;
      ctx.stroke();

      // Joe Body (Blue jacket)
      ctx.fillStyle = '#2563eb';
      ctx.beginPath();
      ctx.roundRect(-6, -2, 14, 18, 4);
      ctx.fill();

      // Joe Head & Sunglasses
      ctx.fillStyle = '#fed7aa'; // skin
      ctx.beginPath();
      ctx.arc(2, -10, 7, 0, Math.PI * 2);
      ctx.fill();

      // Black Cap
      ctx.fillStyle = '#1e293b';
      ctx.beginPath();
      ctx.arc(2, -12, 7, Math.PI, Math.PI * 2);
      ctx.fill();
      ctx.fillRect(-2, -12, 10, 2); // visor

      // Sunglasses
      ctx.fillStyle = '#0f172a';
      ctx.fillRect(1, -11, 7, 3);

      ctx.restore();
    }

    function renderScene(progress, isCrash, joeOffset) {
      const w = canvas.width / window.devicePixelRatio;
      const h = canvas.height / window.devicePixelRatio;
      ctx.clearRect(0, 0, w, h);

      // Background cosmic gradient
      ctx.fillStyle = '#0c0817';
      ctx.fillRect(0, 0, w, h);

      // Grid
      ctx.strokeStyle = 'rgba(168, 85, 247, 0.06)';
      ctx.lineWidth = 1;
      for (let x = 0; x < w; x += 32) {
        ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, h); ctx.stroke();
      }
      for (let y = 0; y < h; y += 32) {
        ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(w, y); ctx.stroke();
      }

      if (gameState === 'IDLE' || gameState === 'WAITING') {
        drawLuckyJoe(40, h - 35, 0, false);
        return;
      }

      const startX = 20;
      const startY = h - 20;
      const endX = startX + progress * (w - 75);
      const endY = startY - Math.pow(progress, 1.35) * (h - 75) + joeOffset.y;

      // Purple trajectory gradient
      const grad = ctx.createLinearGradient(0, endY, 0, startY);
      if (isCrash) {
        grad.addColorStop(0, 'rgba(239, 68, 68, 0.3)');
        grad.addColorStop(1, 'rgba(239, 68, 68, 0.0)');
      } else {
        grad.addColorStop(0, 'rgba(124, 58, 237, 0.4)');
        grad.addColorStop(1, 'rgba(124, 58, 237, 0.0)');
      }

      ctx.beginPath();
      ctx.moveTo(startX, startY);
      ctx.quadraticCurveTo(startX + (endX - startX) * 0.45, startY, endX, endY);
      ctx.lineTo(endX, startY);
      ctx.closePath();
      ctx.fillStyle = grad;
      ctx.fill();

      // Neon Purple Trajectory Line
      ctx.beginPath();
      ctx.moveTo(startX, startY);
      ctx.quadraticCurveTo(startX + (endX - startX) * 0.45, startY, endX, endY);
      ctx.strokeStyle = isCrash ? '#ef4444' : '#a855f7';
      ctx.lineWidth = 3.5;
      ctx.shadowColor = '#c084fc';
      ctx.shadowBlur = isCrash ? 2 : 12;
      ctx.stroke();
      ctx.shadowBlur = 0;

      if (!isCrash) {
        drawLuckyJoe(endX, endY, -0.25, true);
      } else {
        drawLuckyJoe(endX + joeOffset.crashX, endY + joeOffset.crashY, 0.45, false);
      }
    }

    renderScene(0, false, { y: 0, crashX: 0, crashY: 0 });

    // Round Controller
    function startRound() {
      if (virtualBal < currentBet) {
        alert("Balansingizda mablag' yetarli emas! Balans yangilandi.");
        virtualBal = 1000000;
        balDisplay.textContent = virtualBal.toLocaleString('uz-UZ') + " so'm";
      }

      virtualBal -= currentBet;
      balDisplay.textContent = virtualBal.toLocaleString('uz-UZ') + " so'm";
      winBox.style.display = 'none';
      flewTag.style.display = 'none';

      gameState = 'WAITING';
      actionBtn.className = 'sim-action-btn waiting';
      actionBtn.innerHTML = '<span>KUTILMOQDA...</span>';

      waitingLabel.style.display = 'block';
      waitingBarWrap.style.display = 'block';
      waitingBarFill.style.width = '0%';
      multDisp.textContent = '1.00x';
      multDisp.style.color = '#ffffff';

      let wp = 0;
      const wInt = setInterval(() => {
        wp += 2.5;
        waitingBarFill.style.width = wp + '%';
        renderScene(0, false, { y: 0, crashX: 0, crashY: 0 });

        if (wp >= 100) {
          clearInterval(wInt);
          waitingLabel.style.display = 'none';
          waitingBarWrap.style.display = 'none';
          launchJoe();
        }
      }, 75);
    }

    function launchJoe() {
      gameState = 'FLYING';
      currentMult = 1.00;
      startTime = performance.now();

      const r = Math.random();
      if (r < 0.03) crashTarget = 1.00;
      else if (r < 0.50) crashTarget = 1.15 + Math.random() * 0.90;
      else if (r < 0.82) crashTarget = 2.05 + Math.random() * 2.40;
      else if (r < 0.94) crashTarget = 4.50 + Math.random() * 5.50;
      else crashTarget = 10.0 + Math.random() * 30.0;

      actionBtn.className = 'sim-action-btn cashing';
      updateCashoutLabel();

      function loop(now) {
        const elapsed = (now - startTime) / 1000;
        currentMult = 1.00 + Math.pow(elapsed * 0.72, 1.48);
        multDisp.textContent = currentMult.toFixed(2) + 'x';

        const autoVal = parseFloat(autoCashSelect.value);
        if (autoVal > 0 && currentMult >= autoVal && gameState === 'FLYING') {
          doCashOut();
          return;
        }

        if (currentMult >= crashTarget) {
          doCrash();
          return;
        }

        const progress = Math.min(elapsed / 6.5, 1);
        const floatY = Math.sin(elapsed * 5) * 4;
        renderScene(progress, false, { y: floatY, crashX: 0, crashY: 0 });
        updateCashoutLabel();

        if (gameState === 'FLYING') {
          animId = requestAnimationFrame(loop);
        }
      }
      animId = requestAnimationFrame(loop);
    }

    function updateCashoutLabel() {
      if (gameState !== 'FLYING') return;
      const curWin = Math.round(currentBet * currentMult);
      actionBtn.innerHTML = '<span>YUTUQNI OLISH</span><span style="font-size: 13px; font-weight: 700; color: #fef08a;">' + curWin.toLocaleString('uz-UZ') + " so'm</span>";
    }

    function doCashOut() {
      gameState = 'WON';
      cancelAnimationFrame(animId);
      const won = Math.round(currentBet * currentMult);
      virtualBal += won;
      balDisplay.textContent = virtualBal.toLocaleString('uz-UZ') + " so'm";

      actionBtn.className = 'sim-action-btn';
      actionBtn.innerHTML = '<span>YANA TIKISH</span>';

      winText.innerHTML = "🎉 Omadli Jo bilan <b>" + won.toLocaleString('uz-UZ') + " so'm</b> yutdingiz (" + currentMult.toFixed(2) + "x da)!";
      winBox.style.display = 'block';

      const elapsed = (performance.now() - startTime) / 1000;
      const progress = Math.min(elapsed / 6.5, 1);
      renderScene(progress, false, { y: 0, crashX: 0, crashY: 0 });
    }

    function doCrash() {
      gameState = 'CRASHED';
      cancelAnimationFrame(animId);

      multDisp.textContent = crashTarget.toFixed(2) + 'x';
      multDisp.style.color = '#ef4444';
      flewTag.style.display = 'block';

      addHistoryPill(crashTarget);

      actionBtn.className = 'sim-action-btn';
      actionBtn.innerHTML = '<span>QAYTA TIKISH</span>';

      let cx = 0;
      function flyOff() {
        cx += 1;
        const elapsed = (performance.now() - startTime) / 1000;
        const progress = Math.min(elapsed / 6.5, 1);
        renderScene(progress, true, { y: 0, crashX: cx * 14, crashY: -cx * 8 });
        if (cx < 25) requestAnimationFrame(flyOff);
      }
      flyOff();
    }

    function addHistoryPill(val) {
      const pill = document.createElement('span');
      pill.className = 'history-pill ' + (val < 2 ? 'pill-blue' : (val < 10 ? 'pill-purple' : 'pill-gold'));
      pill.textContent = val.toFixed(2) + 'x';
      historyBar.insertBefore(pill, historyBar.firstChild);
      if (historyBar.children.length > 10) historyBar.removeChild(historyBar.lastChild);
    }

    actionBtn.addEventListener('click', () => {
      if (gameState === 'IDLE' || gameState === 'CRASHED' || gameState === 'WON') {
        startRound();
      } else if (gameState === 'FLYING') {
        doCashOut();
      }
    });

    const betDisp = document.getElementById('bet-disp');
    const chipBtns = document.querySelectorAll('.sim-chip-btn');

    function setBet(amount) {
      if (gameState === 'FLYING' || gameState === 'WAITING') return;
      currentBet = Math.max(5000, Math.min(1000000, amount));
      betDisp.textContent = currentBet.toLocaleString('uz-UZ') + " so'm";
      chipBtns.forEach(c => {
        if (parseInt(c.dataset.b, 10) === currentBet) c.classList.add('active');
        else c.classList.remove('active');
      });
    }

    document.getElementById('btn-plus').addEventListener('click', () => setBet(currentBet + 5000));
    document.getElementById('btn-minus').addEventListener('click', () => setBet(currentBet - 5000));
    chipBtns.forEach(c => c.addEventListener('click', () => setBet(parseInt(c.dataset.b, 10))));

  </script>
