  <!-- Скрипт симулятора Lucky Jet -->
  <script>
    let currentBet = 10000;
    let isRunning = false;
    let multiplier = 1.0;
    let interval = null;
    let crashPoint = 2.0;

    const multEl = document.getElementById('sim-mult');
    const statusEl = document.getElementById('sim-status');
    const joeEl = document.getElementById('sim-joe');
    const btnEl = document.getElementById('sim-btn');
    const resultBox = document.getElementById('sim-result');
    const resultText = document.getElementById('sim-result-text');
    const chipBtns = document.querySelectorAll('.sim-chip-btn');

    chipBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        if (isRunning) return;
        chipBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentBet = parseInt(btn.dataset.bet || '10000', 10);
      });
    });

    btnEl?.addEventListener('click', () => {
      if (!isRunning) {
        isRunning = true;
        multiplier = 1.0;
        resultBox.style.display = 'none';
        btnEl.classList.add('cashing');
        btnEl.textContent = "💰 Jo Yutug'ini Olish";
        statusEl.textContent = "Jo parvoz qilmoqda...";
        statusEl.style.color = "#c084fc";
        
        crashPoint = (Math.random() * 4.5 + 1.25);

        interval = setInterval(() => {
          multiplier += 0.02 * (multiplier * 0.4);
          multEl.textContent = multiplier.toFixed(2) + 'x';

          const progress = Math.min((multiplier - 1) / 3, 1);
          joeEl.style.bottom = (20 + progress * 70) + 'px';
          joeEl.style.left = (20 + progress * 240) + 'px';

          if (multiplier >= crashPoint) {
            clearInterval(interval);
            isRunning = false;
            btnEl.classList.remove('cashing');
            btnEl.textContent = "🔄 Qayta Boshlash";
            statusEl.textContent = "Jo uchib ketdi!";
            statusEl.style.color = "#ef4444";
            multEl.style.color = "#ef4444";
            joeEl.style.transform = "rotate(40deg) translateY(-80px)";
            joeEl.style.opacity = "0";

            setTimeout(() => {
              joeEl.style.transform = "none";
              joeEl.style.opacity = "1";
              joeEl.style.bottom = "20px";
              joeEl.style.left = "20px";
              multEl.style.color = "#ffffff";
            }, 1000);
          }
        }, 50);

      } else {
        clearInterval(interval);
        isRunning = false;
        btnEl.classList.remove('cashing');
        btnEl.textContent = "🚀 Yana O'ynash";
        statusEl.textContent = "Yutuq qayd etildi!";
        statusEl.style.color = "#10b981";

        const wonAmount = Math.round(currentBet * multiplier).toLocaleString('uz-UZ');
        resultText.innerHTML = `Omadli Jo bilan <b>${wonAmount} so'm</b> yutdingiz! 🚀`;
        resultBox.style.display = 'block';
      }
    });
  </script>

</body>
