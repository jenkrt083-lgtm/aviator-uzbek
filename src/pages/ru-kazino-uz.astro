      gap: 7px;
      font-size: 19px;
      font-weight: 900;
      color: #ffffff;
      text-decoration: none;
      letter-spacing: -0.3px;
    }
    .lang-bar {
      display: flex;
      gap: 6px;
    }
    .lang-btn {
