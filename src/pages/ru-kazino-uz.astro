      text-transform: uppercase;
      margin-bottom: 12px;
      letter-spacing: 0.5px;
    }
    .hero-title {
      font-size: 21px;
      font-weight: 900;
      line-height: 1.28;
      color: #ffffff;
      margin-bottom: 8px;
    }
