const refLink = "/go/1win";
const faqSchema = {
  "@context": "https://schema.org", "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Что такое онлайн-казино?", "acceptedAnswer": { "@type": "Answer", "text": "Сайт с играми онлайн: слоты, крэш-игры (Aviator, JetX), рулетка. Честнее работают те, кто использует provably fair — результат можно проверить." } },
    { "@type": "Question", "name": "Казино заблокированы в Узбекистане — как заходить?", "acceptedAnswer": { "@type": "Answer", "text": "Провайдеры блокируют гемблинг-домены. Обход: зеркало (рабочее) или официальный APK. Вход разобран отдельно для Pin Up, Mostbet и 1win." } },
