      display: flex;
      justify-content: center;
    }
    .app-wrapper {
      max-width: 460px;
      width: 100%;
      margin: 0 auto;
      padding: 14px 14px 130px;
      background-color: #0b0e14;
    }

    /* Top Bar */
    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 14px;
    }
    .logo {
      display: flex;
      align-items: center;
      gap: 7px;
      font-size: 19px;
      font-weight: 900;
      color: #ffffff;
      text-decoration: none;
      letter-spacing: -0.3px;
    }
    .lang-bar {
      display: flex;
      gap: 6px;
    }
    .lang-btn {
      font-size: 11px;
      font-weight: 700;
      padding: 5px 11px;
      border-radius: 8px;
      text-decoration: none;
      color: #94a3b8;
      background: #171d28;
      border: 1px solid rgba(255, 255, 255, 0.05);
      transition: all 0.2s;
    }
    .lang-btn.active {
      background: #007aff;
      color: #ffffff;
      border-color: #007aff;
    }

    /* Top Chips */
    .top-chips {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding-bottom: 14px;
      scrollbar-width: none;
    }
    .top-chips::-webkit-scrollbar { display: none; }
    .chip {
      background: #171d28;
      color: #94a3b8;
      font-size: 13px;
      font-weight: 700;
      padding: 8px 16px;
      border-radius: 20px;
      white-space: nowrap;
      text-decoration: none;
      border: 1px solid rgba(255, 255, 255, 0.05);
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }
    .chip.active {
      background: #007aff;
      color: #ffffff;
      border-color: #007aff;
      box-shadow: 0 4px 12px rgba(0, 122, 255, 0.35);
    }

    /* Hero Header */
