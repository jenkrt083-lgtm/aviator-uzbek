const canonical = "https://aviator-uzbek.online/pin-up-aviator/";
const refLink = "/go/1win";
const faqSchema = {
  "@context": "https://schema.org", "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Pin Up da Aviator bormi va ishlaydimi?", "acceptedAnswer": { "@type": "Answer", "text": "Bor — Spribe'ning asl o'yini, provably fair bilan. Men bir necha kuni Pin Up'da ham o'ynab ko'rdim, mexanizm 1win bilan bir xil." } },
