      font-size: 11px;
      font-weight: 800;
      padding: 4px 10px;
      border-radius: 12px;
      text-transform: uppercase;
      margin-bottom: 12px;
      letter-spacing: 0.5px;
    }
    .hero-title {
      font-size: 21px;
      font-weight: 900;
      line-height: 1.28;
      color: #ffffff;
      margin-bottom: 8px;
    }
    .hero-lead {
      font-size: 13px;
      line-height: 1.5;
      color: rgba(255, 255, 255, 0.9);
      margin-bottom: 14px;
    }

