      box-shadow: 0 8px 22px rgba(0, 0, 0, 0.3);
    }
    .strat-card-header {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 10px;
    }
    .strat-num-badge {
      background: #007aff;
      color: #ffffff;
      font-size: 13px;
      font-weight: 900;
      width: 28px;
      height: 28px;
