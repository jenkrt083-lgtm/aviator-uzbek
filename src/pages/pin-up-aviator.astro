      background: linear-gradient(145deg, #9f1239 0%, #be123c 50%, #e11d48 100%);
      border-radius: 24px;
      padding: 22px 18px 20px;
      position: relative;
      overflow: hidden;
      margin-bottom: 16px;
      box-shadow: 0 12px 28px rgba(190, 18, 60, 0.28);
    }
    .hero-strat-box::after {
      content: '🎰';
      position: absolute;
      right: -8px;
