      content: '+';
      font-size: 16px;
      color: #007aff;
      font-weight: 700;
    }
    details[open] .faq-q::after { content: '−'; }
    .faq-a {
      padding: 0 15px 13px;
      font-size: 12px;
      line-height: 1.5;
